---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, canonicalPath } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Decision Management Community — for practitioners, by practitioners.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Decision Management Community</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonicalPath(Astro.url.pathname), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Decision Management Community" href={url('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main class="wrap page">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    min-height: 60vh;
  }
</style>
