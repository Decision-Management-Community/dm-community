<script>
  const profileUrl = '/contributors/adam-dejans-jr/';
  const canonicalName = 'Adam DeJans Jr.';
  const splitPattern = /(Adam DeJans Jr\.?|Adam DeJans)/g;
  const exactPattern = /^(Adam DeJans Jr\.?|Adam DeJans)$/;
  const containsName = /Adam DeJans(?: Jr\.?)?/;
  const root = document.querySelector<HTMLElement>('#main-content');
  const normalizedPath = window.location.pathname.endsWith('/') ? window.location.pathname : `${window.location.pathname}/`;

  if (root && normalizedPath !== profileUrl) {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const value = node.nodeValue ?? '';
        const parent = node.parentElement;
        if (!parent || !containsName.test(value)) return NodeFilter.FILTER_REJECT;
        if (parent.closest('code, pre, script, style, textarea')) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      },
    });

    const matches: Text[] = [];
    let current = walker.nextNode();
    while (current) {
      matches.push(current as Text);
      current = walker.nextNode();
    }

    for (const textNode of matches) {
      const value = textNode.nodeValue ?? '';
      const existingLink = textNode.parentElement?.closest('a');

      if (existingLink) {
        textNode.nodeValue = value.replace(splitPattern, canonicalName);
        if (exactPattern.test(textNode.nodeValue ?? '') && existingLink.dataset.personProfile === 'adam-dejans') {
          existingLink.setAttribute('href', profileUrl);
          existingLink.removeAttribute('target');
          existingLink.removeAttribute('rel');
        }
        continue;
      }

      const fragment = document.createDocumentFragment();

      for (const part of value.split(splitPattern)) {
        if (!part) continue;
        if (!exactPattern.test(part)) {
          fragment.appendChild(document.createTextNode(part));
          continue;
        }

        const link = document.createElement('a');
        link.href = profileUrl;
        link.dataset.personProfile = 'adam-dejans';
        link.textContent = canonicalName;
        fragment.appendChild(link);
      }

      textNode.replaceWith(fragment);
    }
  }
</script>
