---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Decision Management Community"
>
  <rect width="64" height="64" rx="12" fill="var(--color-brand)" />
  <path d="M32 11 L43 21 L32 31 L21 21 Z" fill="var(--color-accent)" />
  <path d="M32 31 L18 48 M32 31 L46 48" stroke="#f4f1ea" stroke-width="3" stroke-linecap="round" />
  <circle cx="18" cy="50" r="5" fill="#f4f1ea" />
  <circle cx="46" cy="50" r="5" fill="#f4f1ea" />
</svg>
