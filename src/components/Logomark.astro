---
import { url } from '../lib/url';

interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---
<img
  class="logomark"
  src={url('/dm-community-logo.png')}
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
  loading="eager"
/>

<style>
  .logomark {
    display: block;
    border-radius: 50%;
    object-fit: cover;
  }
</style>