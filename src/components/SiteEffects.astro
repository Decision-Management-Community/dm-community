<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const localBookCovers = [
    ['bridging decision problems, volume i: framing the problem', 'books/bridging-decision-problems-vol-1.webp'],
    ['the decision factory: a novel about decisions under uncertainty', 'books/the-decision-factory.webp'],
    ['the milp optimization handbook for practitioners', 'books/milp-optimization-handbook.webp'],
    ['business decision modeling with openrules', 'books/business-decision-modeling-openrules.webp'],
  ] as const;

  function attachGlow() {
    if (!finePointer.matches || reducedMotion.matches) return;

    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      if (card.dataset.glowReady === 'true') return;
      card.dataset.glowReady = 'true';

      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
        card.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
        card.dataset.glowActive = 'true';
      });

      card.addEventListener('pointerleave', () => {
        delete card.dataset.glowActive;
      });
    });
  }

  function attachLocalBookCovers() {
    document.querySelectorAll<HTMLElement>('[data-book]').forEach((row) => {
      const searchText = row.dataset.search ?? '';
      const match = localBookCovers.find(([title]) => searchText.startsWith(title));
      if (!match) return;

      const slot = row.querySelector<HTMLElement>('.book-cover-slot');
      if (!slot || slot.querySelector('.local-book-cover')) return;

      // These user-supplied local covers take precedence over any remote cover.
      slot.querySelectorAll<HTMLImageElement>('.book-cover').forEach((image) => {
        image.hidden = true;
      });

      const image = document.createElement('img');
      image.className = 'local-book-cover';
      image.src = `${import.meta.env.BASE_URL}${match[1]}`;
      image.alt = '';
      image.loading = 'lazy';
      slot.appendChild(image);
    });
  }

  attachGlow();
  attachLocalBookCovers();
  document.addEventListener('astro:page-load', () => {
    attachGlow();
    attachLocalBookCovers();
  });
</script>

<style is:global>
  .book-cover-slot .local-book-cover {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--color-bg-alt);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card {
      --glow-x: 50%;
      --glow-y: 50%;
      background-color: var(--color-card);
      background-image: radial-gradient(
        320px circle at var(--glow-x) var(--glow-y),
        color-mix(in srgb, var(--color-accent) 10%, transparent),
        transparent 68%
      );
      background-repeat: no-repeat;
      transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.18s ease;
    }

    .card[data-glow-active='true'] {
      border-color: color-mix(in srgb, var(--color-accent) 52%, var(--color-border));
      box-shadow:
        var(--shadow-card),
        0 10px 32px color-mix(in srgb, var(--color-accent) 8%, transparent);
      transform: translateY(-1px);
    }
  }

  @media (prefers-color-scheme: dark) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card {
      background-image: radial-gradient(
        340px circle at var(--glow-x) var(--glow-y),
        color-mix(in srgb, var(--color-primary) 13%, transparent),
        transparent 68%
      );
    }
    .card[data-glow-active='true'] {
      border-color: color-mix(in srgb, var(--color-primary) 48%, var(--color-border));
      box-shadow:
        var(--shadow-card),
        0 12px 36px rgba(0, 0, 0, 0.22);
    }
  }
</style>
