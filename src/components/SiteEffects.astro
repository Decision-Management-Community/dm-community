<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function attachGlow() {
    if (!finePointer.matches || reducedMotion.matches) return;

    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      if (card.dataset.glowReady === 'true') return;
      card.dataset.glowReady = 'true';

      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
        card.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
        card.dataset.glowActive = 'true';
      });

      card.addEventListener('pointerleave', () => {
        delete card.dataset.glowActive;
      });
    });
  }

  attachGlow();
  document.addEventListener('astro:page-load', attachGlow);
</script>

<style is:global>
  /* Keep the footer page marquee visually quiet and guarantee that each
     repeated set is at least one viewport wide. With two equal sets and the
     existing -50% animation, the loop stays continuous even on wide screens. */
  .page-marquee {
    border-bottom-color: var(--color-border) !important;
    background: color-mix(in srgb, var(--color-card) 86%, var(--color-bg-alt)) !important;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 2.5%, #000 97.5%, transparent) !important;
    mask-image: linear-gradient(to right, transparent, #000 2.5%, #000 97.5%, transparent) !important;
  }

  .page-track {
    animation-duration: 46s !important;
  }

  .page-set {
    box-sizing: border-box;
    width: max-content;
    min-width: 100vw;
    justify-content: space-evenly;
    gap: 0.55rem !important;
    padding: 0.62rem 1rem !important;
  }

  .page-set a {
    padding: 0.34rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg-alt) 78%, transparent);
    color: var(--color-primary) !important;
    font-size: 0.76rem !important;
    letter-spacing: 0.01em !important;
    text-decoration: none !important;
    transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
  }

  .page-set a::after {
    display: none !important;
  }

  .page-set a:hover,
  .page-set a:focus-visible {
    border-color: color-mix(in srgb, var(--color-primary) 48%, var(--color-border));
    background: var(--color-card);
    color: var(--color-accent-dark) !important;
    text-decoration: none !important;
  }

  @media (prefers-color-scheme: dark) {
    .page-marquee {
      background: color-mix(in srgb, var(--color-card) 78%, var(--color-bg-alt)) !important;
    }
    .page-set a {
      background: color-mix(in srgb, var(--color-bg-alt) 62%, transparent);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card {
      --glow-x: 50%;
      --glow-y: 50%;
      background-color: var(--color-card);
      background-image: radial-gradient(
        320px circle at var(--glow-x) var(--glow-y),
        color-mix(in srgb, var(--color-accent) 10%, transparent),
        transparent 68%
      );
      background-repeat: no-repeat;
      transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.18s ease;
    }

    .card[data-glow-active='true'] {
      border-color: color-mix(in srgb, var(--color-accent) 52%, var(--color-border));
      box-shadow:
        var(--shadow-card),
        0 10px 32px color-mix(in srgb, var(--color-accent) 8%, transparent);
      transform: translateY(-1px);
    }
  }

  @media (prefers-color-scheme: dark) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card {
      background-image: radial-gradient(
        340px circle at var(--glow-x) var(--glow-y),
        color-mix(in srgb, var(--color-primary) 13%, transparent),
        transparent 68%
      );
    }
    .card[data-glow-active='true'] {
      border-color: color-mix(in srgb, var(--color-primary) 48%, var(--color-border));
      box-shadow:
        var(--shadow-card),
        0 12px 36px rgba(0, 0, 0, 0.22);
    }
  }
</style>
