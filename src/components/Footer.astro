---
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

const year = new Date().getFullYear();
const sponsors = (await getCollection('sponsors'))
  .filter((s) => s.data.active)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const siteLinks = [
  { href: '/', label: 'Home' },
  { href: '/decisioncamp/', label: 'DecisionCAMP' },
  { href: '/challenges/', label: 'Challenges' },
  { href: '/news/', label: 'News' },
  { href: '/resources/', label: 'Resources' },
  { href: '/qa/', label: 'Q&A' },
  { href: '/events/', label: 'Events' },
  { href: '/vendors-corner/', label: "Vendor's Corner" },
  { href: '/sponsors/', label: 'Sponsors' },
  { href: '/advisory-board/', label: 'Advisory Board' },
  { href: '/about/', label: 'About' },
  { href: '/contribute/', label: 'Contribute' },
];
---
<footer class="site-footer">
  <nav class="page-links" aria-label="Explore major pages">
    <div class="wrap page-links-inner">
      {siteLinks.map((item) => <a href={url(item.href)}>{item.label}</a>)}
    </div>
  </nav>

  <div class="wrap footer-grid">
    <div>
      <strong>Decision Management Community</strong>
      <p class="muted">For practitioners, by practitioners. Business rules, decision modeling, optimization, machine learning, and agentic AI for decision-making.</p>
    </div>
    <div>
      <h4>Community</h4>
      <ul>
        <li><a href={url('/advisory-board/')}>Advisory Board</a></li>
        <li><a href="https://www.linkedin.com/in/decision-management-community-b0537a96">LinkedIn</a></li>
        <li><a href={url('/rss.xml')}>RSS Feed</a></li>
      </ul>
    </div>
    <div>
      <h4>Contribute</h4>
      <ul>
        <li><a href={url('/contribute/')}>How to contribute</a></li>
        <li><a href="mailto:DecisionManagementCommunity@gmail.com">Email the community</a></li>
        <li><a href={url('/about/terms-and-conditions/')}>Terms &amp; Conditions</a></li>
      </ul>
    </div>
  </div>

  {sponsors.length > 0 && (
    <section class="sponsor-band" aria-labelledby="sponsor-heading">
      <div class="wrap sponsor-heading-row">
        <div>
          <span class="sponsor-kicker">Community partners</span>
          <h2 id="sponsor-heading">Supported by</h2>
        </div>
        <a class="all-sponsors" href={url('/sponsors/')}>Meet our sponsors &rarr;</a>
      </div>

      <div class="sponsor-marquee" aria-label="Community sponsors">
        <div class="sponsor-track">
          <div class="sponsor-set">
            {sponsors.map((s) => (
              <a class:list={['sponsor-tile', { 'text-only': !s.data.logo }]} data-sponsor-id={s.id} href={s.data.url} target="_blank" rel="noopener" aria-label={`Visit ${s.data.name}`}>
                {s.data.logo ? (
                  <img src={url(s.id === 'bit-bros' ? '/sponsors/bit-bros-horizontal.svg' : s.data.logo)} alt={`${s.data.name} logo`} loading="lazy" />
                ) : (
                  <span>{s.data.name}</span>
                )}
              </a>
            ))}
          </div>
          <div class="sponsor-set sponsor-set-copy" aria-hidden="true">
            {sponsors.map((s) => (
              <a class:list={['sponsor-tile', { 'text-only': !s.data.logo }]} data-sponsor-id={s.id} href={s.data.url} target="_blank" rel="noopener" tabindex="-1">
                {s.data.logo ? (
                  <img src={url(s.id === 'bit-bros' ? '/sponsors/bit-bros-horizontal.svg' : s.data.logo)} alt="" loading="lazy" />
                ) : (
                  <span>{s.data.name}</span>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <div class="wrap sub">
    <span class="muted">&copy; {year} Decision Management Community</span>
    <div class="maintenance-credit">
      <a href={url('/contribute/')}>Open-source contributions welcome</a>
    </div>
  </div>
</footer>

<script>
  const marquee = document.querySelector<HTMLElement>('.sponsor-marquee');
  const bitBrosTiles = marquee?.querySelectorAll<HTMLElement>('[data-sponsor-id="bit-bros"]');

  if (marquee && bitBrosTiles?.length) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animationFrame = 0;
    let isActive = false;

    const resetSpotlight = () => {
      bitBrosTiles.forEach((tile) => {
        tile.style.setProperty('--center-focus', '0');
        tile.style.setProperty('--logo-wiggle', '0deg');
      });
    };

    const updateSpotlight = () => {
      if (!isActive) return;

      const viewportCenter = window.innerWidth / 2;
      const focusRadius = Math.max(180, Math.min(window.innerWidth * 0.28, 360));
      const wiggleAmplitude = window.innerWidth <= 700 ? 2 : 2.6;

      bitBrosTiles.forEach((tile) => {
        const rect = tile.getBoundingClientRect();
        const tileCenter = rect.left + rect.width / 2;
        const signedDistance = tileCenter - viewportCenter;
        const distance = Math.abs(signedDistance);
        const proximity = Math.max(0, 1 - distance / focusRadius);
        const eased = proximity * proximity * (3 - 2 * proximity);
        const wiggleEnvelope = Math.max(0, (eased - 0.55) / 0.45);
        const normalizedOffset = signedDistance / focusRadius;
        const wiggle = Math.sin(normalizedOffset * Math.PI * 7) * wiggleEnvelope * wiggleAmplitude;

        tile.style.setProperty('--center-focus', eased.toFixed(3));
        tile.style.setProperty('--logo-wiggle', `${wiggle.toFixed(2)}deg`);
      });

      animationFrame = window.requestAnimationFrame(updateSpotlight);
    };

    const setActive = (nextActive: boolean) => {
      const shouldRun = nextActive && !reducedMotion.matches;
      if (shouldRun === isActive) return;

      isActive = shouldRun;
      window.cancelAnimationFrame(animationFrame);

      if (isActive) {
        animationFrame = window.requestAnimationFrame(updateSpotlight);
      } else {
        resetSpotlight();
      }
    };

    const observer = new IntersectionObserver(
      ([entry]) => setActive(Boolean(entry?.isIntersecting)),
      { rootMargin: '80px 0px' },
    );

    observer.observe(marquee);
    reducedMotion.addEventListener('change', () => setActive(true));
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-top: 0;
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .page-links {
    width: 100%;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card) 68%, var(--color-bg-alt));
  }
  .page-links-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem 0.5rem;
    padding-top: 0.72rem;
    padding-bottom: 0.72rem;
  }
  .page-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 0.34rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-card) 88%, transparent);
    color: var(--color-text-muted);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
  }
  .page-links a:hover,
  .page-links a:focus-visible {
    border-color: color-mix(in srgb, var(--color-primary) 48%, var(--color-border));
    background: color-mix(in srgb, var(--color-primary) 7%, var(--color-card));
    color: var(--color-text);
    text-decoration: none;
  }

  .sponsor-band {
    padding: 1.25rem 0 1.35rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card) 55%, transparent);
  }
  .sponsor-heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  .sponsor-kicker {
    display: block;
    color: var(--color-accent-dark);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 0.1rem;
  }
  .sponsor-heading-row h2 {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin: 0;
  }
  .all-sponsors {
    flex: 0 0 auto;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .sponsor-marquee {
    --marquee-gap: 0.75rem;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  }
  .sponsor-track {
    display: flex;
    width: max-content;
    animation: sponsor-scroll 42s linear infinite;
    will-change: transform;
  }
  .sponsor-set {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
  }
  .sponsor-marquee:hover .sponsor-track,
  .sponsor-marquee:focus-within .sponsor-track {
    animation-play-state: paused;
  }
  .sponsor-tile {
    --tile-lift: 0px;
    --tile-scale: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 54px;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
    text-decoration: none;
    transform: translateY(var(--tile-lift)) scale(var(--tile-scale));
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .sponsor-tile:hover,
  .sponsor-tile:focus-visible {
    --tile-lift: -2px;
    border-color: rgba(43, 74, 124, 0.32);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.10);
    text-decoration: none;
  }
  .sponsor-tile img {
    display: block;
    max-width: 126px;
    max-height: 32px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .sponsor-tile.text-only {
    color: #334155;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
  }
  .sponsor-tile[data-sponsor-id='bit-bros'] {
    --center-focus: 0;
    --logo-wiggle: 0deg;
    --tile-scale: calc(1 + (var(--center-focus) * 0.22));
    position: relative;
    z-index: 1;
    background:
      linear-gradient(
        rgba(15, 23, 42, calc(var(--center-focus) * 0.96)),
        rgba(15, 23, 42, calc(var(--center-focus) * 0.96))
      ),
      rgba(255, 255, 255, 0.97);
    border-color: rgba(15, 23, 42, calc(0.10 + (var(--center-focus) * 0.16)));
    box-shadow: 0 1px calc(2px + (var(--center-focus) * 16px)) rgba(15, 23, 42, calc(0.05 + (var(--center-focus) * 0.10)));
  }
  .sponsor-tile[data-sponsor-id='bit-bros'] img {
    filter: invert(var(--center-focus)) brightness(calc(1 + (var(--center-focus) * 0.08)));
    transform: rotate(var(--logo-wiggle));
    transform-origin: center;
    will-change: filter, transform;
  }

  @keyframes sponsor-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .footer-grid h4 {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .footer-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sub {
    border-top: 1px solid var(--color-border);
    padding: 0.85rem 1.5rem 1rem;
    font-size: 0.78rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .maintenance-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  @media (prefers-color-scheme: dark) {
    .sponsor-band {
      background: color-mix(in srgb, var(--color-card) 72%, transparent);
    }
    .sponsor-tile {
      /* Keep original brand artwork on a predictable neutral canvas. */
      background: rgba(255, 255, 255, 0.96);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .sponsor-tile:hover,
    .sponsor-tile:focus-visible {
      border-color: rgba(221, 165, 83, 0.48);
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.32);
    }
    .sponsor-tile[data-sponsor-id='bit-bros'] {
      background:
        linear-gradient(
          rgba(15, 23, 42, calc(var(--center-focus) * 0.96)),
          rgba(15, 23, 42, calc(var(--center-focus) * 0.96))
        ),
        rgba(255, 255, 255, 0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsor-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: thin;
    }
    .sponsor-track { animation: none; }
    .sponsor-set-copy { display: none; }
    .sponsor-tile,
    .page-links a { transition: none; }
    .sponsor-tile[data-sponsor-id='bit-bros'] {
      --center-focus: 0 !important;
      --logo-wiggle: 0deg !important;
    }
  }

  @media (max-width: 700px) {
    .page-links-inner {
      gap: 0.4rem;
      padding-top: 0.65rem;
      padding-bottom: 0.65rem;
    }
    .page-links a {
      min-height: 30px;
      padding: 0.32rem 0.62rem;
      font-size: 0.73rem;
    }
    .sponsor-heading-row { align-items: flex-start; }
    .sponsor-tile { width: 132px; height: 50px; }
    .sponsor-tile[data-sponsor-id='bit-bros'] {
      --tile-scale: calc(1 + (var(--center-focus) * 0.17));
    }
    .footer-grid { grid-template-columns: 1fr; }
    .sub { align-items: flex-start; flex-direction: column; }
    .maintenance-credit { flex-wrap: wrap; }
  }
</style>
