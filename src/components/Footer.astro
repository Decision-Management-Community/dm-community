---
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

const year = new Date().getFullYear();
const sponsors = (await getCollection('sponsors'))
  .filter((s) => s.data.active)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const siteLinks = [
  { href: '/', label: 'Home' },
  { href: '/decisioncamp/', label: 'DecisionCAMP' },
  { href: '/challenges/', label: 'Challenges' },
  { href: '/news/', label: 'News' },
  { href: '/resources/', label: 'Resources' },
  { href: '/qa/', label: 'Q&A' },
  { href: '/events/', label: 'Events' },
  { href: '/vendors-corner/', label: "Vendor's Corner" },
  { href: '/sponsors/', label: 'Sponsors' },
  { href: '/advisory-board/', label: 'Advisory Board' },
  { href: '/about/', label: 'About' },
  { href: '/contribute/', label: 'Contribute' },
];
---
<footer class="site-footer">
  <nav class="page-marquee" aria-label="Explore major pages">
    <div class="page-track">
      <div class="page-set">
        {siteLinks.map((item) => <a href={url(item.href)}>{item.label}</a>)}
      </div>
      <div class="page-set page-set-copy" aria-hidden="true">
        {siteLinks.map((item) => <a href={url(item.href)} tabindex="-1">{item.label}</a>)}
      </div>
    </div>
  </nav>

  <div class="wrap footer-grid">
    <div>
      <strong>Decision Management Community</strong>
      <p class="muted">For practitioners, by practitioners. Business rules, decision modeling, optimization, machine learning, and agentic AI for decision-making.</p>
    </div>
    <div>
      <h4>Community</h4>
      <ul>
        <li><a href={url('/advisory-board/')}>Advisory Board</a></li>
        <li><a href={url('/sponsors/')}>Sponsors</a></li>
        <li><a href="https://groups.google.com/forum/#!forum/dmcommunity">Google Discussion Group</a></li>
        <li><a href="https://www.linkedin.com/in/decision-management-community-b0537a96">LinkedIn</a></li>
        <li><a href="https://x.com/DecisionMgtCom">X / Twitter</a></li>
        <li><a href={url('/rss.xml')}>RSS Feed</a></li>
      </ul>
    </div>
    <div>
      <h4>Contribute</h4>
      <ul>
        <li><a href={url('/contribute/')}>How to contribute</a></li>
        <li><a href="mailto:DecisionManagementCommunity@gmail.com">Email the community</a></li>
        <li><a href={url('/about/terms-and-conditions/')}>Terms &amp; Conditions</a></li>
      </ul>
    </div>
  </div>

  {sponsors.length > 0 && (
    <section class="sponsor-band" aria-labelledby="sponsor-heading">
      <div class="wrap sponsor-heading-row">
        <div>
          <span class="sponsor-kicker">Community partners</span>
          <h2 id="sponsor-heading">Supported by</h2>
        </div>
        <a class="all-sponsors" href={url('/sponsors/')}>Meet our sponsors &rarr;</a>
      </div>

      <div class="sponsor-marquee" aria-label="Community sponsors">
        <div class="sponsor-track">
          <div class="sponsor-set">
            {sponsors.map((s) => (
              <a class:list={['sponsor-tile', { 'text-only': !s.data.logo }]} href={s.data.url} target="_blank" rel="noopener" aria-label={`Visit ${s.data.name}`}>
                {s.data.logo ? (
                  <img src={url(s.id === 'bit-bros' ? '/sponsors/bit-bros-horizontal.svg' : s.data.logo)} alt={`${s.data.name} logo`} loading="lazy" />
                ) : (
                  <span>{s.data.name}</span>
                )}
              </a>
            ))}
          </div>
          <div class="sponsor-set sponsor-set-copy" aria-hidden="true">
            {sponsors.map((s) => (
              <a class:list={['sponsor-tile', { 'text-only': !s.data.logo }]} href={s.data.url} target="_blank" rel="noopener" tabindex="-1">
                {s.data.logo ? (
                  <img src={url(s.id === 'bit-bros' ? '/sponsors/bit-bros-horizontal.svg' : s.data.logo)} alt="" loading="lazy" />
                ) : (
                  <span>{s.data.name}</span>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <div class="wrap sub">
    <span class="muted">&copy; {year} Decision Management Community</span>
    <div class="maintenance-credit">
      <a class="maintainer" href="https://bitbrosdata.com" target="_blank" rel="noopener">
        <span>Maintained with <span aria-label="love">💙</span> by</span>
        <span class="maintainer-name">Bit Bros LLC</span>
      </a>
      <span class="credit-dot" aria-hidden="true">·</span>
      <a href={url('/contribute/')}>Open-source contributions welcome</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-top: 0;
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .page-marquee {
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 72%, #fff);
    background: var(--color-primary-dark);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
  }
  .page-track {
    display: flex;
    width: max-content;
    animation: page-scroll 38s linear infinite;
    will-change: transform;
  }
  .page-set {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem 0.78rem 0;
  }
  .page-set a {
    position: relative;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-decoration: none;
    white-space: nowrap;
  }
  .page-set a::after {
    position: absolute;
    left: calc(100% + 0.68rem);
    color: var(--color-accent);
    content: '◆';
    font-size: 0.52rem;
    top: 0.22rem;
  }
  .page-set a:hover,
  .page-set a:focus-visible { color: #f5c57d; text-decoration: underline; }
  .page-marquee:hover .page-track,
  .page-marquee:focus-within .page-track { animation-play-state: paused; }

  .sponsor-band {
    padding: 1.25rem 0 1.35rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card) 55%, transparent);
  }
  .sponsor-heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  .sponsor-kicker {
    display: block;
    color: var(--color-accent-dark);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 0.1rem;
  }
  .sponsor-heading-row h2 {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin: 0;
  }
  .all-sponsors {
    flex: 0 0 auto;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .sponsor-marquee {
    --marquee-gap: 0.75rem;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  }
  .sponsor-track {
    display: flex;
    width: max-content;
    animation: sponsor-scroll 42s linear infinite;
    will-change: transform;
  }
  .sponsor-set {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
  }
  .sponsor-marquee:hover .sponsor-track,
  .sponsor-marquee:focus-within .sponsor-track {
    animation-play-state: paused;
  }
  .sponsor-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 54px;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .sponsor-tile:hover,
  .sponsor-tile:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(43, 74, 124, 0.32);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.10);
    text-decoration: none;
  }
  .sponsor-tile img {
    display: block;
    max-width: 126px;
    max-height: 32px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .sponsor-tile.text-only {
    color: #334155;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
  }

  @keyframes sponsor-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes page-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
  .footer-grid h4 {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .footer-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sub {
    border-top: 1px solid var(--color-border);
    padding: 0.85rem 1.5rem 1rem;
    font-size: 0.78rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .maintenance-credit,
  .maintainer {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .maintainer { color: var(--color-text-muted); }
  .maintainer:hover { text-decoration: none; color: var(--color-text); }
  .maintainer-name {
    color: #2563eb;
    font-weight: 750;
    letter-spacing: 0.01em;
  }
  .maintainer:hover .maintainer-name { color: #1d4ed8; }
  .credit-dot { color: var(--color-text-muted); }

  @media (prefers-color-scheme: dark) {
    .sponsor-band {
      background: color-mix(in srgb, var(--color-card) 72%, transparent);
    }
    .sponsor-tile {
      /* Keep original brand artwork on a predictable neutral canvas. */
      background: rgba(255, 255, 255, 0.96);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .sponsor-tile:hover,
    .sponsor-tile:focus-visible {
      border-color: rgba(221, 165, 83, 0.48);
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.32);
    }
    .maintainer-name { color: #60a5fa; }
    .maintainer:hover .maintainer-name { color: #93c5fd; }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-marquee,
    .sponsor-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: thin;
    }
    .page-track,
    .sponsor-track { animation: none; }
    .page-set-copy,
    .sponsor-set-copy { display: none; }
    .sponsor-tile { transition: none; }
  }

  @media (max-width: 700px) {
    .sponsor-heading-row { align-items: flex-start; }
    .sponsor-tile { width: 132px; height: 50px; }
    .footer-grid { grid-template-columns: 1fr; }
    .sub { align-items: flex-start; flex-direction: column; }
    .maintenance-credit { flex-wrap: wrap; }
  }
</style>
