---
import { url } from '../lib/url';
import Logomark from './Logomark.astro';

const primaryNav = [
  { href: url('/'), label: 'Home' },
  { href: url('/about/'), label: 'About' },
  { href: url('/news/'), label: 'News' },
  { href: url('/decisioncamp/'), label: 'DecisionCAMP' },
  { href: url('/challenges/'), label: 'Challenges' },
  { href: url('/resources/'), label: 'Resources' },
];
const moreNav = [
  { href: url('/qa/'), label: 'Q&A' },
  { href: url('/events/'), label: 'Events' },
  { href: url('/vendors-corner/'), label: "Vendor's Corner" },
  { href: url('/sponsors/'), label: 'Sponsors' },
  { href: url('/advisory-board/'), label: 'Advisory Board' },
  { href: url('/contribute/'), label: 'Contribute' },
];
const path = Astro.url.pathname;
const homeHref = url('/');
const isHrefActive = (href: string) =>
  href === homeHref ? path === homeHref : path === href || path.startsWith(href);
const isMoreActive = moreNav.some((item) => isHrefActive(item.href));
const pagefindBundlePath = url('/pagefind/');
const pagefindUiJs = url('/pagefind/pagefind-ui.js');
const pagefindUiCss = url('/pagefind/pagefind-ui.css');
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label="Decision Management Community home">
      <Logomark size={32} />
      <span class="brand-name">Decision Management Community</span>
    </a>
    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={isHrefActive(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
      <div class="nav-more">
        <button
          class="nav-more-toggle"
          id="nav-more-toggle"
          aria-expanded="false"
          aria-controls="nav-more-menu"
          aria-current={isMoreActive ? 'page' : undefined}
        >
          More
          <svg class="chev" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="nav-more-menu" id="nav-more-menu" hidden>
          {moreNav.map((item) => (
            <a
              href={item.href}
              aria-current={isHrefActive(item.href) ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </div>
      </div>
    </nav>
    <button
      class="icon-btn"
      id="search-toggle"
      aria-expanded="false"
      aria-controls="search-panel"
      aria-label="Open search"
      aria-keyshortcuts="/"
      title="Search (/)"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6" />
        <path d="M12.5 12.5L16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="search-panel" id="search-panel" hidden>
    <div class="wrap" role="search" aria-label="Site search">
      <div id="pagefind-search"></div>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover { text-decoration: none; }
  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    justify-content: flex-end;
  }
  .site-nav a {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.25rem;
    padding: 0.3rem 0;
  }
  .site-nav a:hover { color: var(--color-text); text-decoration: none; }
  .site-nav a[aria-current='page'] {
    color: var(--color-text);
    border-bottom: 2px solid var(--color-accent);
  }
  .nav-more {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-more-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    background: none;
    border: none;
    font-family: inherit;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.25rem;
    padding: 0.3rem 0;
    cursor: pointer;
  }
  .nav-more-toggle:hover { color: var(--color-text); }
  .nav-more-toggle[aria-current='page'] {
    color: var(--color-text);
    border-bottom: 2px solid var(--color-accent);
  }
  .nav-more-toggle .chev {
    transition: transform 0.15s ease;
  }
  .nav-more-toggle[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
  .nav-more-menu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.6rem;
    min-width: 180px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: var(--shadow-card);
    padding: 0.4rem;
    z-index: 30;
  }
  .nav-more-menu:not([hidden]) {
    display: flex;
    flex-direction: column;
  }
  .nav-more-menu a {
    padding: 0.55rem 0.6rem;
    border-radius: 6px;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .nav-more-menu a:hover {
    background: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
  }
  .nav-more-menu a[aria-current='page'] { color: var(--color-text); }
  .icon-btn,
  .nav-toggle {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
  }
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .icon-btn:hover { color: var(--color-text); border-color: var(--color-accent); }
  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0;
    cursor: pointer;
  }
  .nav-toggle span {
    width: 18px;
    height: 2px;
    background: var(--color-text);
    display: block;
  }
  .search-panel {
    border-top: 1px solid var(--color-border);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .search-panel .wrap { padding: 1.1rem 1.5rem; }

  @media (max-width: 860px) {
    .bar {
      flex-wrap: wrap;
      gap: 0.55rem;
      padding-top: 0.65rem;
      padding-bottom: 0.65rem;
    }
    .brand { margin-right: auto; }
    .nav-toggle { display: flex; }
    .site-nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      order: 3;
      gap: 0;
      margin-top: 0.15rem;
      padding: 0.35rem 0 0.55rem;
      border-top: 1px solid var(--color-border);
    }
    .site-nav.open { display: flex; }
    .site-nav > a,
    .nav-more-menu a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0.55rem 0.25rem;
      border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    }
    .site-nav > a:last-of-type { border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent); }
    .site-nav a[aria-current='page'] { border-bottom-color: var(--color-accent); }
    .nav-more { display: contents; }
    .nav-more-toggle { display: none; }
    .nav-more-menu {
      display: contents !important;
    }
    .search-panel .wrap { padding: 0.85rem 1rem 1rem; }
  }

  @media (max-width: 460px) {
    .brand-name { display: none; }
  }
</style>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  function setNavOpen(open: boolean) {
    nav?.classList.toggle('open', open);
    navToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    navToggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
  }

  navToggle?.addEventListener('click', () => {
    setNavOpen(!nav?.classList.contains('open'));
  });

  const moreToggle = document.getElementById('nav-more-toggle');
  const moreMenu = document.getElementById('nav-more-menu');
  function closeMoreMenu() {
    moreMenu?.setAttribute('hidden', '');
    moreToggle?.setAttribute('aria-expanded', 'false');
  }
  moreToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const opening = moreMenu?.hasAttribute('hidden');
    if (opening) {
      moreMenu?.removeAttribute('hidden');
      moreToggle.setAttribute('aria-expanded', 'true');
    } else {
      closeMoreMenu();
    }
  });
  document.addEventListener('click', (event) => {
    if (!moreMenu || moreMenu.hasAttribute('hidden')) return;
    const target = event.target as Node;
    if (moreToggle?.contains(target) || moreMenu.contains(target)) return;
    closeMoreMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    if (moreMenu && !moreMenu.hasAttribute('hidden')) {
      closeMoreMenu();
      moreToggle?.focus();
    }

    if (nav?.classList.contains('open')) {
      setNavOpen(false);
      navToggle?.focus();
    }
  });
</script>

<script define:vars={{ pagefindBundlePath, pagefindUiJs, pagefindUiCss }}>
  const searchToggle = document.getElementById('search-toggle');
  const searchPanel = document.getElementById('search-panel');
  let pagefindLoaded = false;

  function setSearchToggleState(open) {
    searchToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    searchToggle?.setAttribute('aria-label', open ? 'Close search' : 'Open search');
  }

  async function loadPagefindUi() {
    if (pagefindLoaded) return;
    pagefindLoaded = true;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = pagefindUiCss;
    document.head.appendChild(link);
    await new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = pagefindUiJs;
      script.onload = resolve;
      script.onerror = reject;
      document.body.appendChild(script);
    });
    // eslint-disable-next-line no-undef
    new PagefindUI({ element: '#pagefind-search', bundlePath: pagefindBundlePath, showSubResults: true });
  }

  async function openSearch() {
    if (!searchPanel) return;
    searchPanel.removeAttribute('hidden');
    setSearchToggleState(true);
    try {
      await loadPagefindUi();
    } catch {
      pagefindLoaded = false;
    }
    searchPanel.querySelector('input')?.focus();
  }

  function closeSearch(restoreFocus = false) {
    searchPanel?.setAttribute('hidden', '');
    setSearchToggleState(false);
    if (restoreFocus) searchToggle?.focus();
  }

  searchToggle?.addEventListener('click', async () => {
    if (searchPanel?.hasAttribute('hidden')) {
      await openSearch();
    } else {
      closeSearch();
    }
  });

  function isEditableTarget(target) {
    return target instanceof HTMLElement && (
      target.isContentEditable ||
      target.tagName === 'INPUT' ||
      target.tagName === 'TEXTAREA' ||
      target.tagName === 'SELECT'
    );
  }

  document.addEventListener('keydown', async (event) => {
    if (
      event.key === '/' &&
      !event.metaKey &&
      !event.ctrlKey &&
      !event.altKey &&
      !isEditableTarget(event.target)
    ) {
      event.preventDefault();
      await openSearch();
      return;
    }

    if (event.key === 'Escape' && searchPanel && !searchPanel.hasAttribute('hidden')) {
      closeSearch(true);
    }
  });
</script>
