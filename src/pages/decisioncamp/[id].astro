---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { url } from '../../lib/url';
import { migrateLegacyUrl } from '../../lib/legacyUrl.mjs';

export async function getStaticPaths() {
  const editions = await getCollection('decisioncamp');
  return editions.map((e) => ({ params: { id: e.id }, props: { entry: e } }));
}

const legacyMediaArchivePrefix = 'https://web.archive.org/web/20200101000000id_/https://dmcommunity.org/wp-content/uploads/';

function eventHrefFor(value: string | undefined) {
  if (!value) return undefined;
  const migrated = migrateLegacyUrl(value);
  if (migrated.startsWith('/news-media/')) {
    const localMediaPath = join(process.cwd(), 'public', migrated.replace(/^\/+/, ''));
    if (!existsSync(localMediaPath)) return ${legacyMediaArchivePrefix};
  }
  return migrated.startsWith('/') ? url(migrated) : migrated;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const eventHref = eventHrefFor(entry.data.url);
const eventExternal = eventHref?.startsWith('http://') || eventHref?.startsWith('https://');
---
<BaseLayout title={entry.data.title} description={`${entry.data.title} — Decision Management Community`}>
  <a href={url('/decisioncamp/')}>&larr; All DecisionCAMP editions</a>
  <h1>{entry.data.title}</h1>
  {entry.data.location && <p class="muted">{entry.data.location}</p>}
  {eventHref && (
    <p><a class="btn secondary" href={eventHref} target={eventExternal ? '_blank' : undefined} rel={eventExternal ? 'noopener' : undefined}>Event material &rarr;</a></p>
  )}

  <article class="prose">
    <Content />
  </article>
</BaseLayout>
