---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

const [newsPosts, challenges, articles, contributors, events] = await Promise.all([
  getCollection('news'),
  getCollection('challenges'),
  getCollection('articles'),
  getCollection('contributors'),
  getCollection('events'),
]);

newsPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
challenges.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestNews = newsPosts.slice(0, 6);
const latestChallenge = challenges[0];
const latestArticles = articles.slice(0, 3);
const openChallenges = challenges.filter((challenge) => challenge.data.solutions.length === 0).length;

const today = new Date();
today.setUTCHours(0, 0, 0, 0);
const nextEvent = events
  .filter((event) => event.data.startDate.valueOf() >= today.valueOf())
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())[0];
---
<BaseLayout title="Home" description="Decision Management Community — practitioners designing, building, operating, and improving decision systems.">
  <section class="hero">
    <div class="hero-copy">
      <span class="kicker">Decision Management, in practice</span>
      <h1>Towards Better Operational Decisions</h1>
      <p class="intro">
        The Decision Management Community brings together practitioners who design, build, operate,
        and improve decision systems across multiple industries.
      </p>
      <p class="lede">
        Explore ideas, methods, tools, and real-world practice across Business Rules, Decision Modeling,
        Decision Optimization, Machine Learning, and Agentic AI — maintained by practitioners for practitioners.
      </p>
      <p class="contributor-count">
        <a href={url('/contributors/')} aria-label={`${contributors.length}+ community contributors`}>
          <strong data-count-value data-count-target={contributors.length}>0+</strong>
          <span>community contributors</span>
        </a>
      </p>
    </div>
    <div class="hero-actions">
      <img class="hero-logo" src={url('/hero-dm-circle.png')} alt="Decision Management Community" />
      <nav class="hero-links" aria-label="Explore the community">
        <a href={url('/news/')}>News</a>
        <a href={url('/challenges/')}>Challenges</a>
        <a href={url('/decisioncamp/')}>DecisionCAMP</a>
        <a href={url('/resources/')}>Resources</a>
        <a href={url('/contribute/')}>Contribute</a>
      </nav>
    </div>
  </section>

  <section class="section-block news-first" aria-labelledby="latest-news-heading">
    <div class="section-heading-row">
      <div>
        <span class="eyebrow">Fresh from the community</span>
        <h2 id="latest-news-heading">Latest news</h2>
      </div>
      <a href={url('/news/')}>More news &rarr;</a>
    </div>
    {latestNews.length > 0 ? (
      <div class="latest-grid">
        {latestNews.map((post) => {
          const opensInNewTab = Boolean(post.data.directLink && post.data.sourceUrl);
          const postHref = opensInNewTab ? post.data.sourceUrl! : url(`/news/${post.id}/`);
          return (
            <article class="compact-card news-card">
              <h3><a href={postHref} target={opensInNewTab ? '_blank' : undefined} rel={opensInNewTab ? 'noopener' : undefined}>{post.data.title}</a></h3>
              <p class="meta">{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p>
            </article>
          );
        })}
      </div>
    ) : <p class="muted">No news yet.</p>}
  </section>

  <section class="section-block" aria-labelledby="start-heading">
    <div class="section-heading-row">
      <div>
        <span class="eyebrow">Start here</span>
        <h2 id="start-heading">Use the community, not just the archive</h2>
      </div>
    </div>
    <div class="path-grid">
      <a class="path-card" href={url('/challenges/')}>
        <span class="path-number">01</span>
        <h3>Solve a real challenge</h3>
        <p>Browse the archive, filter for open problems, compare existing approaches, and submit your own solution.</p>
        <span class="card-arrow">Explore challenges &rarr;</span>
      </a>
      <a class="path-card" href={url('/resources/')}>
        <span class="path-number">02</span>
        <h3>Learn from working examples</h3>
        <p>Find articles, decision models, case studies, standards, tools, books, and community software in one place.</p>
        <span class="card-arrow">Browse resources &rarr;</span>
      </a>
      <a class="path-card" href={url('/contribute/')}>
        <span class="path-number">03</span>
        <h3>Put your work in the record</h3>
        <p>Contribute an article, challenge solution, event, tool, case study, or correction and get proper attribution.</p>
        <span class="card-arrow">How to contribute &rarr;</span>
      </a>
    </div>
  </section>

  <section class="section-block" aria-labelledby="pulse-heading">
    <div class="section-heading-row">
      <div>
        <span class="eyebrow">Community pulse</span>
        <h2 id="pulse-heading">What to look at right now</h2>
      </div>
    </div>
    <div class="pulse-grid">
      {latestChallenge && (
        <article class="pulse-card">
          <span class="badge">Latest challenge</span>
          <h3><a href={url(`/challenges/${latestChallenge.id}/`)}>{latestChallenge.data.title}</a></h3>
          <p class="meta">{latestChallenge.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</p>
          <p class="muted">
            {latestChallenge.data.solutions.length > 0
              ? `${latestChallenge.data.solutions.length} published solution${latestChallenge.data.solutions.length === 1 ? '' : 's'} so far.`
              : 'No published solutions yet — this one is wide open.'}
          </p>
          <a class="card-arrow" href={url(`/challenges/${latestChallenge.id}/`)}>Open challenge &rarr;</a>
        </article>
      )}

      <article class="pulse-card">
        <span class="badge">Open problems</span>
        <h3>{openChallenges} challenges still need a solution</h3>
        <p class="muted">Use the open-only filter to jump straight to problems where a fresh contribution can add the most value.</p>
        <a class="card-arrow" href={url('/challenges/#challenge-search-input')}>Find an open challenge &rarr;</a>
      </article>

      {nextEvent ? (
        <article class="pulse-card">
          <span class="badge">Next event</span>
          <h3><a href={url('/events/')}>{nextEvent.data.title}</a></h3>
          <p class="meta">{nextEvent.data.startDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p>
          {nextEvent.data.location && <p class="muted">{nextEvent.data.location}</p>}
          <a class="card-arrow" href={url('/events/')}>View events &rarr;</a>
        </article>
      ) : (
        <article class="pulse-card">
          <span class="badge">DecisionCAMP</span>
          <h3>Talk to the people doing the work</h3>
          <p class="muted">Explore DecisionCAMP sessions, presentations, and community history across the annual conference archive.</p>
          <a class="card-arrow" href={url('/decisioncamp/')}>Explore DecisionCAMP &rarr;</a>
        </article>
      )}
    </div>
  </section>

  {latestArticles.length > 0 && (
    <section class="section-block" aria-labelledby="latest-articles-heading">
      <div class="section-heading-row">
        <div>
          <span class="eyebrow">Deep dives</span>
          <h2 id="latest-articles-heading">Latest articles</h2>
        </div>
        <a href={url('/resources/articles/')}>All articles &rarr;</a>
      </div>
      <div class="article-grid">
        {latestArticles.map((article) => (
          <article class="compact-card">
            <h3><a href={url(`/resources/articles/${article.id}/`)}>{article.data.title}</a></h3>
            <p class="meta">
              {article.data.author ? `${article.data.author} · ` : ''}
              {article.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
            </p>
            {article.data.summary && <p class="muted">{article.data.summary}</p>}
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const contributorCounter = document.querySelector<HTMLElement>('[data-count-value]');

  if (contributorCounter) {
    const target = Number(contributorCounter.dataset.countTarget ?? 0);
    const format = new Intl.NumberFormat('en-US');
    const render = (value: number) => {
      contributorCounter.textContent = `${format.format(value)}+`;
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || target <= 0) {
      render(target);
    } else {
      const duration = 3600;
      let startedAt: number | undefined;

      const tick = (now: number) => {
        startedAt ??= now;
        const progress = Math.min(1, (now - startedAt) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        render(Math.round(target * eased));

        if (progress < 1) window.requestAnimationFrame(tick);
      };

      window.requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 720px) 150px;
    justify-content: start;
    align-items: start;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding: clamp(2rem, 5vw, 3.8rem);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background:
      radial-gradient(circle at 92% 10%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 32%),
      var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .hero-copy { max-width: 72ch; }
  .hero-copy h1 {
    max-width: 17ch;
    margin: 0.35rem 0 1rem;
    font-size: clamp(2.1rem, 4.5vw, 3.45rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .kicker,
  .eyebrow {
    display: block;
    color: var(--color-accent-dark);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .intro,
  .lede {
    max-width: 64ch;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  .intro { margin-top: 1.25rem; font-size: 1.08rem; }
  .lede { font-size: 1rem; }

  .contributor-count {
    margin: 0.95rem 0 0;
  }
  .contributor-count a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .contributor-count a:hover span,
  .contributor-count a:focus-visible span {
    color: var(--color-text);
  }
  .contributor-count strong {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }
  .contributor-count span {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    width: 150px;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .hero-logo {
    width: clamp(100px, 12vw, 132px);
    height: clamp(100px, 12vw, 132px);
    object-fit: contain;
  }
  .hero-links {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.55rem;
  }
  .hero-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 46px;
    padding: 0.42rem 0.78rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg-alt) 72%, transparent);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
  }
  .hero-links a:hover,
  .hero-links a:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-card);
    color: var(--color-accent-dark);
    text-decoration: none;
  }

  .section-block { padding: 3.5rem 0 0; }
  .news-first { padding-top: 2.4rem; }
  .section-heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .section-heading-row h2 { margin: 0.15rem 0 0; }
  .section-heading-row > a { flex: 0 0 auto; font-weight: 650; }

  .path-grid,
  .pulse-grid,
  .article-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .path-card,
  .pulse-card,
  .compact-card {
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .path-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  .path-card:hover,
  .path-card:focus-visible {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .path-card h3,
  .pulse-card h3,
  .compact-card h3 { margin: 0.35rem 0 0.55rem; }
  .path-card p,
  .pulse-card p { line-height: 1.6; }
  .path-number {
    color: var(--color-accent-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .pulse-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
  }
  .pulse-card .badge { align-self: flex-start; }
  .compact-card { padding: 1.35rem; }
  .compact-card .muted { line-height: 1.55; }

  .card-arrow { display: inline-block; margin-top: auto; padding-top: 1rem; font-weight: 650; }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .news-card h3 { margin-top: 0; }
  .meta { margin: 0.25rem 0; color: var(--color-text-muted); font-size: 0.82rem; }

  @media (max-width: 940px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 145px;
      gap: 1.25rem;
    }
    .path-grid,
    .pulse-grid,
    .article-grid { grid-template-columns: 1fr; }
    .latest-grid { grid-template-columns: 1fr; }
    .hero-copy h1 { max-width: 16ch; }
  }

  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 1.4rem;
    }
    .hero-actions {
      width: 100%;
      margin-top: 0.35rem;
      align-items: flex-start;
      justify-self: stretch;
    }
    .hero-logo { width: 84px; height: 84px; }
    .hero-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 0;
    }
    .hero-links a { width: auto; }
    .hero-links a:last-child { grid-column: 1 / -1; }
    .section-block { padding-top: 2.5rem; }
    .news-first { padding-top: 2rem; }
    .section-heading-row { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 380px) {
    .hero-links { grid-template-columns: 1fr; }
    .hero-links a:last-child { grid-column: auto; }
  }
</style>
