---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

const sponsors = (await getCollection('sponsors'))
  .filter((s) => s.data.active)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<BaseLayout title="Sponsors" description="Sponsors of the Decision Management Community.">
  <h1>Sponsors</h1>
  <p>
    Sponsors help support the ongoing maintenance, events, and community resources of the Decision
    Management Community while keeping participation open to practitioners.
  </p>

  <h2>Current Sponsors</h2>
  <div class="card-grid sponsor-grid">
    {sponsors.map((s) => (
      <div class:list={['card', 'sponsor-card', { 'sponsor-card-bit-bros': s.id === 'bit-bros' }]}>
        <a
          href={s.data.url}
          target="_blank"
          rel="noopener"
          class:list={['sponsor-logo-link', { 'sponsor-logo-link-bit-bros': s.id === 'bit-bros' }]}
          aria-label={`Visit ${s.data.name}`}
        >
          {s.data.logo ? (
            <img
              class:list={['sponsor-logo', { 'sponsor-logo-mark': s.id === 'bit-bros' }]}
              src={url(s.data.logo)}
              alt={`${s.data.name} logo`}
              loading="lazy"
            />
          ) : (
            <span class="sponsor-logo-text">{s.data.name}</span>
          )}
        </a>
        <h3><a href={s.data.url} target="_blank" rel="noopener">{s.data.name}</a></h3>
        <p class="muted">{s.body?.trim()}</p>
      </div>
    ))}
  </div>

  <h2>Become a Sponsor</h2>
  <div class="card">
    <p><strong>Sponsorship fee:</strong> $600 per year (single tier)</p>
    <p><strong>Benefits include:</strong></p>
    <ul>
      <li>Logo and link in the sitewide sponsor strip</li>
      <li>Company profile and homepage link in the Sponsors section</li>
      <li>Ability to submit relevant product announcements to News and Vendor's Corner</li>
      <li>Relevant event listings on the community Events page</li>
      <li>Automatic inclusion as a DecisionCAMP sponsor</li>
    </ul>
    <p>
      Sponsorship supports the community but does not provide editorial control. Content, listings,
      reviews, and community guidance remain independently maintained.
    </p>
    <p><strong>To apply:</strong> email a company/product profile (max 150 words), a logo, and the URL the logo should link to, to <a href="mailto:DecisionManagementCommunity@gmail.com">DecisionManagementCommunity@gmail.com</a>. An invoice will be provided.</p>
  </div>
</BaseLayout>

<style>
  .sponsor-grid {
    align-items: stretch;
  }
  .sponsor-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
  }
  .sponsor-card h3 {
    margin: 0 0 0.35rem;
  }
  .sponsor-card > p {
    margin: 0;
  }

  .sponsor-card-bit-bros {
    --bit-bros-blue: #38b6ff;
    --bit-bros-blue-dark: #2867b2;
    position: relative;
    transition:
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
    animation: bit-bros-card-spotlight 14s ease-in-out infinite;
  }
  .sponsor-card-bit-bros::after {
    position: absolute;
    top: -1px;
    right: 16%;
    left: 16%;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--bit-bros-blue), transparent);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scaleX(0.65);
    transform-origin: center;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .sponsor-card-bit-bros:hover,
  .sponsor-card-bit-bros:focus-within {
    animation: none;
    border-color: rgba(56, 182, 255, 0.62);
    box-shadow:
      var(--shadow-card),
      0 12px 30px rgba(40, 103, 178, 0.16),
      inset 0 0 0 1px rgba(56, 182, 255, 0.08);
    transform: translateY(-2px);
  }
  .sponsor-card-bit-bros:hover::after,
  .sponsor-card-bit-bros:focus-within::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .sponsor-logo-link {
    --logo-stage-bg: rgba(255, 255, 255, 0.97);
    --logo-stage-border: rgba(15, 23, 42, 0.10);
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 112px;
    flex: 0 0 112px;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
    overflow: hidden;
    border: 1px solid var(--logo-stage-border);
    border-radius: 10px;
    background-color: var(--logo-stage-bg);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .sponsor-logo-link:hover,
  .sponsor-logo-link:focus-visible {
    border-color: rgba(43, 74, 124, 0.32);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.09);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .sponsor-logo {
    display: block;
    width: min(190px, 82%);
    height: 64px;
    max-width: 82%;
    max-height: 64px;
    object-fit: contain;
    object-position: center;
  }
  .sponsor-logo-mark {
    width: 76px;
    height: 76px;
    max-width: 76px;
    max-height: 76px;
  }
  .sponsor-logo-text {
    max-width: 86%;
    color: #334155;
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.25;
    text-align: center;
  }

  /* Bit Bros still gets the occasional passive spotlight, but hovering anywhere
     on its card (or focusing a link inside it) triggers the treatment immediately.
     The brand mark stays black against Bit Bros blue; white inversion is reserved
     for genuinely dark/black logo stages such as the footer spotlight. */
  .sponsor-logo-link-bit-bros {
    --bit-bros-blue: #38b6ff;
    --bit-bros-blue-dark: #2867b2;
    animation: bit-bros-stage-spotlight 14s ease-in-out infinite;
    will-change: background-color, border-color, box-shadow;
  }
  .sponsor-logo-link-bit-bros .sponsor-logo {
    transform-origin: center;
    animation: bit-bros-logo-spotlight 14s ease-in-out infinite;
    will-change: filter, transform;
  }

  .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros,
  .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros {
    animation: none;
    background-color: var(--bit-bros-blue);
    border-color: var(--bit-bros-blue-dark);
    box-shadow: 0 9px 24px rgba(56, 182, 255, 0.28);
    transform: translateY(-1px);
  }
  .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros .sponsor-logo,
  .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros .sponsor-logo {
    animation: bit-bros-card-highlight 460ms ease-out both;
    filter: invert(0) brightness(1);
  }

  @keyframes bit-bros-card-spotlight {
    0%, 69%, 92%, 100% {
      border-color: var(--color-border);
      box-shadow: var(--shadow-card);
      transform: translateY(0);
    }
    76%, 86% {
      border-color: rgba(56, 182, 255, 0.38);
      box-shadow:
        var(--shadow-card),
        0 8px 22px rgba(40, 103, 178, 0.11);
      transform: translateY(-1px);
    }
  }

  @keyframes bit-bros-card-highlight {
    0% {
      filter: invert(0) brightness(1);
      transform: rotate(0deg) scale(1);
    }
    30% {
      filter: invert(0) brightness(1);
      transform: rotate(-2deg) scale(1.03);
    }
    55% {
      filter: invert(0) brightness(1);
      transform: rotate(2.4deg) scale(1.05);
    }
    75% {
      filter: invert(0) brightness(1);
      transform: rotate(-1.2deg) scale(1.05);
    }
    100% {
      filter: invert(0) brightness(1);
      transform: rotate(0deg) scale(1.05);
    }
  }

  @keyframes bit-bros-stage-spotlight {
    0%, 69%, 92%, 100% {
      background-color: var(--logo-stage-bg);
      border-color: var(--logo-stage-border);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    76%, 86% {
      background-color: var(--bit-bros-blue);
      border-color: var(--bit-bros-blue-dark);
      box-shadow: 0 9px 24px rgba(56, 182, 255, 0.28);
    }
  }

  @keyframes bit-bros-logo-spotlight {
    0%, 69%, 92%, 100% {
      filter: invert(0) brightness(1);
      transform: rotate(0deg) scale(1);
    }
    73% {
      filter: invert(0) brightness(1);
      transform: rotate(-1.5deg) scale(1.02);
    }
    76% {
      filter: invert(0) brightness(1);
      transform: rotate(2.2deg) scale(1.04);
    }
    79% {
      filter: invert(0) brightness(1);
      transform: rotate(-2.5deg) scale(1.05);
    }
    82% {
      filter: invert(0) brightness(1);
      transform: rotate(1.7deg) scale(1.05);
    }
    84% {
      filter: invert(0) brightness(1);
      transform: rotate(-0.8deg) scale(1.05);
    }
    86% {
      filter: invert(0) brightness(1);
      transform: rotate(0deg) scale(1.05);
    }
    90% {
      filter: invert(0) brightness(1);
      transform: rotate(0deg) scale(1);
    }
  }

  @media (prefers-color-scheme: dark) {
    .sponsor-logo-link {
      --logo-stage-bg: rgba(255, 255, 255, 0.96);
      --logo-stage-border: rgba(255, 255, 255, 0.12);
    }
    .sponsor-logo-link:hover,
    .sponsor-logo-link:focus-visible {
      border-color: rgba(221, 165, 83, 0.48);
      box-shadow: 0 7px 20px rgba(0, 0, 0, 0.28);
    }
    .sponsor-card-bit-bros:hover,
    .sponsor-card-bit-bros:focus-within {
      border-color: rgba(56, 182, 255, 0.72);
      box-shadow:
        var(--shadow-card),
        0 12px 30px rgba(56, 182, 255, 0.14),
        inset 0 0 0 1px rgba(56, 182, 255, 0.10);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsor-logo-link,
    .sponsor-card-bit-bros,
    .sponsor-card-bit-bros::after {
      transition: none;
    }
    .sponsor-logo-link:hover,
    .sponsor-logo-link:focus-visible {
      transform: none;
    }
    .sponsor-card-bit-bros,
    .sponsor-logo-link-bit-bros,
    .sponsor-logo-link-bit-bros .sponsor-logo {
      animation: none;
    }
    .sponsor-card-bit-bros:hover,
    .sponsor-card-bit-bros:focus-within,
    .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros,
    .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros {
      transform: none;
    }
    .sponsor-card-bit-bros:hover::after,
    .sponsor-card-bit-bros:focus-within::after {
      transform: none;
    }
    .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros .sponsor-logo,
    .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros .sponsor-logo {
      animation: none;
      filter: invert(0) brightness(1);
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .sponsor-logo-link {
      height: 100px;
      flex-basis: 100px;
    }
    .sponsor-logo {
      height: 58px;
      max-height: 58px;
    }
    .sponsor-logo-mark {
      width: 68px;
      height: 68px;
      max-width: 68px;
      max-height: 68px;
    }
  }
</style>
