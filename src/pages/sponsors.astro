---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

const sponsors = (await getCollection('sponsors'))
  .filter((s) => s.data.active)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<BaseLayout title="Sponsors" description="Sponsors of the Decision Management Community.">
  <h1>Sponsors</h1>
  <p>
    Sponsors help support the ongoing maintenance, events, and community resources of the Decision
    Management Community while keeping participation open to practitioners.
  </p>

  <h2>Current Sponsors</h2>
  <div class="card-grid sponsor-grid">
    {sponsors.map((s) => (
      <div class:list={['card', 'sponsor-card', { 'sponsor-card-bit-bros': s.id === 'bit-bros' }]}>
        <a
          href={s.data.url}
          target="_blank"
          rel="noopener"
          class:list={['sponsor-logo-link', { 'sponsor-logo-link-bit-bros': s.id === 'bit-bros' }]}
          aria-label={`Visit ${s.data.name}`}
        >
          {s.data.logo ? (
            <img
              class:list={['sponsor-logo', { 'sponsor-logo-mark': s.id === 'bit-bros' }]}
              src={url(s.data.logo)}
              alt={`${s.data.name} logo`}
              loading="lazy"
            />
          ) : (
            <span class="sponsor-logo-text">{s.data.name}</span>
          )}
        </a>
        <h3><a href={s.data.url} target="_blank" rel="noopener">{s.data.name}</a></h3>
        <p class="muted">{s.body?.trim()}</p>
      </div>
    ))}
  </div>

  <h2>Become a Sponsor</h2>
  <div class="card">
    <p><strong>Sponsorship fee:</strong> $600 per year (single tier)</p>
    <p><strong>Benefits include:</strong></p>
    <ul>
      <li>Logo and link in the sitewide sponsor strip</li>
      <li>Company profile and homepage link in the Sponsors section</li>
      <li>Ability to submit relevant product announcements to News and Vendor's Corner</li>
      <li>Relevant event listings on the community Events page</li>
      <li>Automatic inclusion as a DecisionCAMP sponsor</li>
    </ul>
    <p>
      Sponsorship supports the community but does not provide editorial control. Content, listings,
      reviews, and community guidance remain independently maintained.
    </p>
    <p><strong>To apply:</strong> email a company/product profile (max 150 words), a logo, and the URL the logo should link to, to <a href="mailto:DecisionManagementCommunity@gmail.com">DecisionManagementCommunity@gmail.com</a>. An invoice will be provided.</p>
  </div>
</BaseLayout>

<script>
  const bitBrosCard = document.querySelector<HTMLElement>('.sponsor-card-bit-bros');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  if (bitBrosCard && finePointer.matches) {
    const palette = ['#38b6ff', '#6eccff', '#2867b2'];
    let activeParticles = 0;
    let lastTrailAt = 0;
    let lastTrailX = 0;
    let lastTrailY = 0;

    const createRing = (x: number, y: number, power: number) => {
      if (activeParticles >= 64 || reducedMotion.matches) return;

      const ring = document.createElement('span');
      ring.className = 'bit-bros-cursor-ring';
      ring.style.left = `${x}px`;
      ring.style.top = `${y}px`;
      ring.style.setProperty('--ring-scale', `${1.7 + power * 0.45}`);
      document.body.appendChild(ring);
      activeParticles += 1;
      ring.addEventListener('animationend', () => {
        ring.remove();
        activeParticles = Math.max(0, activeParticles - 1);
      }, { once: true });
    };

    const burst = (x: number, y: number, power = 1, count = 8) => {
      if (reducedMotion.matches || activeParticles >= 64) return;

      createRing(x, y, power);
      const available = Math.max(0, 64 - activeParticles);
      const particleCount = Math.min(count, available);

      for (let i = 0; i < particleCount; i += 1) {
        const spark = document.createElement('span');
        const angle = ((Math.PI * 2) / particleCount) * i + (Math.random() - 0.5) * 0.5;
        const distance = (22 + Math.random() * 34) * power;
        const size = 3 + Math.random() * 3.5;

        spark.className = 'bit-bros-cursor-spark';
        spark.style.left = `${x}px`;
        spark.style.top = `${y}px`;
        spark.style.width = `${size}px`;
        spark.style.height = `${size}px`;
        spark.style.background = palette[i % palette.length];
        spark.style.setProperty('--spark-x', `${Math.cos(angle) * distance}px`);
        spark.style.setProperty('--spark-y', `${Math.sin(angle) * distance}px`);
        spark.style.setProperty('--spark-rotate', `${(Math.random() - 0.5) * 180}deg`);
        document.body.appendChild(spark);
        activeParticles += 1;

        spark.addEventListener('animationend', () => {
          spark.remove();
          activeParticles = Math.max(0, activeParticles - 1);
        }, { once: true });
      }
    };

    bitBrosCard.addEventListener('pointerenter', (event) => {
      lastTrailAt = performance.now();
      lastTrailX = event.clientX;
      lastTrailY = event.clientY;
      burst(event.clientX, event.clientY, 1.15, 11);
    });

    bitBrosCard.addEventListener('pointermove', (event) => {
      const now = performance.now();
      const distance = Math.hypot(event.clientX - lastTrailX, event.clientY - lastTrailY);
      if (now - lastTrailAt < 105 || distance < 24) return;

      lastTrailAt = now;
      lastTrailX = event.clientX;
      lastTrailY = event.clientY;
      burst(event.clientX, event.clientY, 0.68, 4);
    });

    bitBrosCard.addEventListener('pointerdown', (event) => {
      burst(event.clientX, event.clientY, 1.45, 15);
    });

    bitBrosCard.addEventListener('focusin', () => {
      if (reducedMotion.matches) return;
      const rect = bitBrosCard.getBoundingClientRect();
      burst(rect.left + rect.width / 2, rect.top + Math.min(90, rect.height * 0.35), 1.05, 9);
    });
  }
</script>

<style>
  .sponsor-grid {
    align-items: stretch;
  }
  .sponsor-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
  }
  .sponsor-card h3 {
    margin: 0 0 0.35rem;
  }
  .sponsor-card > p {
    margin: 0;
  }

  .sponsor-card-bit-bros {
    --bit-bros-blue: #38b6ff;
    --bit-bros-blue-dark: #2867b2;
    --bit-bros-black: #060611;
    position: relative;
    z-index: 1;
    transition:
      background-color 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s ease;
    animation: bit-bros-card-spotlight 14s ease-in-out infinite;
  }
  .sponsor-card-bit-bros::after {
    position: absolute;
    top: -1px;
    right: 8%;
    left: 8%;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--bit-bros-blue), transparent);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scaleX(0.55);
    transform-origin: center;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .sponsor-card-bit-bros h3 a {
    transition: color 0.2s ease;
  }
  .sponsor-card-bit-bros:hover,
  .sponsor-card-bit-bros:focus-within {
    z-index: 2;
    animation: none;
    background-color: color-mix(in srgb, var(--color-card) 94%, var(--bit-bros-blue) 6%);
    border-color: rgba(56, 182, 255, 0.84);
    box-shadow:
      var(--shadow-card),
      0 18px 44px rgba(56, 182, 255, 0.22),
      0 0 0 1px rgba(56, 182, 255, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transform: translateY(-4px) scale(1.012);
  }
  .sponsor-card-bit-bros:hover::after,
  .sponsor-card-bit-bros:focus-within::after {
    opacity: 1;
    transform: scaleX(1);
  }
  .sponsor-card-bit-bros:hover h3 a,
  .sponsor-card-bit-bros:focus-within h3 a {
    color: var(--bit-bros-blue-dark);
  }

  .sponsor-logo-link {
    --logo-stage-bg: rgba(255, 255, 255, 0.97);
    --logo-stage-border: rgba(15, 23, 42, 0.10);
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 112px;
    flex: 0 0 112px;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    padding: 1rem 1.2rem;
    overflow: hidden;
    border: 1px solid var(--logo-stage-border);
    border-radius: 10px;
    background-color: var(--logo-stage-bg);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .sponsor-logo-link:hover,
  .sponsor-logo-link:focus-visible {
    border-color: rgba(43, 74, 124, 0.32);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.09);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .sponsor-logo {
    display: block;
    width: min(190px, 82%);
    height: 64px;
    max-width: 82%;
    max-height: 64px;
    object-fit: contain;
    object-position: center;
  }
  .sponsor-logo-mark {
    width: 76px;
    height: 76px;
    max-width: 76px;
    max-height: 76px;
  }
  .sponsor-logo-text {
    max-width: 86%;
    color: #334155;
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.25;
    text-align: center;
  }

  /* Bit Bros uses the branded black + blue lockup when spotlighted. The blue
     mark is rendered with an exact-color SVG mask over the existing black mark. */
  .sponsor-logo-link-bit-bros {
    --bit-bros-blue: #38b6ff;
    --bit-bros-blue-dark: #2867b2;
    --bit-bros-black: #060611;
    position: relative;
    animation: bit-bros-stage-spotlight 14s ease-in-out infinite;
    will-change: background-color, border-color, box-shadow;
  }
  .sponsor-logo-link-bit-bros::before {
    position: absolute;
    width: 76px;
    height: 76px;
    background: var(--bit-bros-blue);
    content: '';
    opacity: 0;
    pointer-events: none;
    -webkit-mask: url('/sponsors/bit-bros-mark.svg') center / contain no-repeat;
    mask: url('/sponsors/bit-bros-mark.svg') center / contain no-repeat;
    transform-origin: center;
    animation: bit-bros-logo-blue-spotlight 14s ease-in-out infinite;
    will-change: opacity, transform;
  }
  .sponsor-logo-link-bit-bros .sponsor-logo {
    position: relative;
    z-index: 1;
    transform-origin: center;
    animation: bit-bros-logo-black-spotlight 14s ease-in-out infinite;
    will-change: opacity, transform;
  }

  .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros,
  .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros {
    animation: none;
    background-color: var(--bit-bros-black);
    border-color: rgba(56, 182, 255, 0.74);
    box-shadow:
      0 12px 30px rgba(6, 6, 17, 0.30),
      0 0 0 1px rgba(56, 182, 255, 0.16);
    transform: translateY(-2px) scale(1.01);
  }
  .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros .sponsor-logo,
  .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros .sponsor-logo {
    animation: none;
    opacity: 0;
  }
  .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros::before,
  .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros::before {
    opacity: 1;
    animation: bit-bros-card-highlight 460ms ease-out both;
  }

  :global(.bit-bros-cursor-spark),
  :global(.bit-bros-cursor-ring) {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
  }
  :global(.bit-bros-cursor-spark) {
    border-radius: 999px;
    box-shadow: 0 0 9px rgba(56, 182, 255, 0.75);
    animation: bit-bros-spark-burst 560ms cubic-bezier(0.16, 0.78, 0.28, 1) forwards;
    will-change: transform, opacity;
  }
  :global(.bit-bros-cursor-ring) {
    width: 13px;
    height: 13px;
    border: 2px solid rgba(56, 182, 255, 0.9);
    border-radius: 999px;
    box-shadow: 0 0 12px rgba(56, 182, 255, 0.32);
    animation: bit-bros-ring-burst 460ms ease-out forwards;
    will-change: transform, opacity;
  }

  @keyframes bit-bros-spark-burst {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    70% {
      opacity: 0.92;
    }
    100% {
      opacity: 0;
      transform:
        translate(-50%, -50%)
        translate3d(var(--spark-x), var(--spark-y), 0)
        rotate(var(--spark-rotate))
        scale(0.35);
    }
  }

  @keyframes bit-bros-ring-burst {
    0% {
      opacity: 0.95;
      transform: translate(-50%, -50%) scale(0.35);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(var(--ring-scale));
    }
  }

  @keyframes bit-bros-card-spotlight {
    0%, 69%, 92%, 100% {
      border-color: var(--color-border);
      box-shadow: var(--shadow-card);
      transform: translateY(0) scale(1);
    }
    76%, 86% {
      border-color: rgba(56, 182, 255, 0.44);
      box-shadow:
        var(--shadow-card),
        0 10px 26px rgba(56, 182, 255, 0.13);
      transform: translateY(-1px) scale(1.004);
    }
  }

  @keyframes bit-bros-card-highlight {
    0% { transform: rotate(0deg) scale(1); }
    30% { transform: rotate(-2deg) scale(1.03); }
    55% { transform: rotate(2.4deg) scale(1.05); }
    75% { transform: rotate(-1.2deg) scale(1.05); }
    100% { transform: rotate(0deg) scale(1.05); }
  }

  @keyframes bit-bros-stage-spotlight {
    0%, 69%, 92%, 100% {
      background-color: var(--logo-stage-bg);
      border-color: var(--logo-stage-border);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    76%, 86% {
      background-color: var(--bit-bros-black);
      border-color: rgba(56, 182, 255, 0.72);
      box-shadow:
        0 12px 28px rgba(6, 6, 17, 0.24),
        0 0 0 1px rgba(56, 182, 255, 0.14);
    }
  }

  @keyframes bit-bros-logo-black-spotlight {
    0%, 69%, 92%, 100% {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
    73% {
      opacity: 0.7;
      transform: rotate(-1.5deg) scale(1.02);
    }
    76% {
      opacity: 0.25;
      transform: rotate(2.2deg) scale(1.04);
    }
    79%, 86% {
      opacity: 0;
      transform: rotate(0deg) scale(1.05);
    }
    90% {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  @keyframes bit-bros-logo-blue-spotlight {
    0%, 69%, 92%, 100% {
      opacity: 0;
      transform: rotate(0deg) scale(1);
    }
    73% {
      opacity: 0.3;
      transform: rotate(-1.5deg) scale(1.02);
    }
    76% {
      opacity: 0.75;
      transform: rotate(2.2deg) scale(1.04);
    }
    79% {
      opacity: 1;
      transform: rotate(-2.5deg) scale(1.05);
    }
    82% {
      opacity: 1;
      transform: rotate(1.7deg) scale(1.05);
    }
    84% {
      opacity: 1;
      transform: rotate(-0.8deg) scale(1.05);
    }
    86% {
      opacity: 1;
      transform: rotate(0deg) scale(1.05);
    }
    90% {
      opacity: 0;
      transform: rotate(0deg) scale(1);
    }
  }

  @media (prefers-color-scheme: dark) {
    .sponsor-logo-link {
      --logo-stage-bg: rgba(255, 255, 255, 0.96);
      --logo-stage-border: rgba(255, 255, 255, 0.12);
    }
    .sponsor-logo-link:hover,
    .sponsor-logo-link:focus-visible {
      border-color: rgba(221, 165, 83, 0.48);
      box-shadow: 0 7px 20px rgba(0, 0, 0, 0.28);
    }
    .sponsor-card-bit-bros:hover,
    .sponsor-card-bit-bros:focus-within {
      background-color: color-mix(in srgb, var(--color-card) 90%, var(--bit-bros-blue) 10%);
      border-color: rgba(56, 182, 255, 0.90);
      box-shadow:
        var(--shadow-card),
        0 18px 44px rgba(56, 182, 255, 0.22),
        0 0 0 1px rgba(56, 182, 255, 0.18),
        inset 0 1px 0 rgba(56, 182, 255, 0.08);
    }
    .sponsor-card-bit-bros:hover h3 a,
    .sponsor-card-bit-bros:focus-within h3 a {
      color: var(--bit-bros-blue);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsor-logo-link,
    .sponsor-card-bit-bros,
    .sponsor-card-bit-bros::after,
    .sponsor-card-bit-bros h3 a {
      transition: none;
    }
    .sponsor-logo-link:hover,
    .sponsor-logo-link:focus-visible {
      transform: none;
    }
    .sponsor-card-bit-bros,
    .sponsor-logo-link-bit-bros,
    .sponsor-logo-link-bit-bros::before,
    .sponsor-logo-link-bit-bros .sponsor-logo {
      animation: none;
    }
    .sponsor-card-bit-bros:hover,
    .sponsor-card-bit-bros:focus-within,
    .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros,
    .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros {
      transform: none;
    }
    .sponsor-card-bit-bros:hover::after,
    .sponsor-card-bit-bros:focus-within::after {
      transform: none;
    }
    .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros .sponsor-logo,
    .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros .sponsor-logo {
      opacity: 0;
    }
    .sponsor-card-bit-bros:hover .sponsor-logo-link-bit-bros::before,
    .sponsor-card-bit-bros:focus-within .sponsor-logo-link-bit-bros::before {
      opacity: 1;
      animation: none;
      transform: none;
    }
    :global(.bit-bros-cursor-spark),
    :global(.bit-bros-cursor-ring) {
      display: none;
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .sponsor-logo-link {
      height: 100px;
      flex-basis: 100px;
    }
    .sponsor-logo {
      height: 58px;
      max-height: 58px;
    }
    .sponsor-logo-mark,
    .sponsor-logo-link-bit-bros::before {
      width: 68px;
      height: 68px;
      max-width: 68px;
      max-height: 68px;
    }
  }
</style>