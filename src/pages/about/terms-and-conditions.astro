---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'terms-and-conditions');
const { Content } = await render(entry!);
---
<BaseLayout title="Terms and Conditions" description={entry?.data.description}>
  <article class="prose">
    <h1>{entry?.data.title}</h1>
    <Content />
  </article>
</BaseLayout>

<style>
  .prose :global(p) { max-width: 72ch; }
</style>
