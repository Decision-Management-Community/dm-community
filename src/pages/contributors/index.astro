---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import { getCollection } from 'astro:content';
import { canonicalAuthorNames } from '../../lib/authorUrl';
import { contributorFullName, contributorPath, decisionCampPresentationYears } from '../../lib/contributorProfile';
import { url } from '../../lib/url';

const contributors = await getCollection('contributors');
const [articles, challenges, qa, news] = await Promise.all([
  getCollection('articles'),
  getCollection('challenges'),
  getCollection('qa'),
  getCollection('news'),
]);

function profileMentionTokens(contributor: (typeof contributors)[number]) {
  const tokens = [
    contributorFullName(contributor.data),
    `${contributor.data.firstName} ${contributor.data.lastName}`,
  ];

  if (contributor.data.linkedin) {
    try {
      const handle = new URL(contributor.data.linkedin).pathname.split('/').filter(Boolean).pop();
      if (handle) tokens.push(handle);
    } catch {
      // Ignore malformed legacy links; schema validation handles normal cases.
    }
  }

  return [...new Set(tokens.filter(Boolean))];
}

function contributorStats(contributor: (typeof contributors)[number]) {
  const names = new Set(canonicalAuthorNames(contributorFullName(contributor.data)));
  const isByContributor = (author?: string) => canonicalAuthorNames(author).some((candidate) => names.has(candidate));
  const authoredArticles = articles.filter((item) => isByContributor(item.data.author));
  const authoredSolutions = challenges.flatMap((challenge) =>
    challenge.data.solutions
      .filter((solution) => isByContributor(solution.author))
      .map((solution) => ({ challenge, solution })),
  );
  const authoredQa = qa.filter((item) => isByContributor(item.data.author));
  const authoredNews = news.filter((item) => isByContributor(item.data.author));
  const presentationYears = decisionCampPresentationYears(`${contributor.data.shortBio}\n${contributor.body ?? ''}`);

  const substantiveDates = [
    ...authoredArticles.map((item) => item.data.date.valueOf()),
    ...authoredSolutions.map(({ challenge }) => challenge.data.date.valueOf()),
    ...authoredQa.map((item) => item.data.date.valueOf()),
    ...presentationYears.map((year) => Date.UTC(year, 0, 1)),
  ];

  return {
    count: authoredArticles.length + authoredSolutions.length + authoredQa.length + authoredNews.length + presentationYears.length,
    substantiveCount: authoredArticles.length + authoredSolutions.length + authoredQa.length + presentationYears.length,
    depthScore:
      authoredArticles.length * 4 +
      authoredSolutions.length * 4 +
      authoredQa.length * 3 +
      authoredNews.length + presentationYears.length * 2,
    latestSubstantive: substantiveDates.length > 0 ? Math.max(...substantiveDates) : 0,
  };
}

function indexedNewsMentionCount(contributor: (typeof contributors)[number]) {
  const names = new Set(canonicalAuthorNames(contributorFullName(contributor.data)));
  const isByContributor = (author?: string) => canonicalAuthorNames(author).some((candidate) => names.has(candidate));
  const tokens = profileMentionTokens(contributor);

  return news.filter((item) => {
    if (isByContributor(item.data.author)) return false;
    const body = typeof item.body === 'string' ? item.body : '';
    return tokens.some((token) => body.includes(token));
  }).length;
}

const rows = contributors.map((entry) => ({
  entry,
  ...contributorStats(entry),
  mentions: indexedNewsMentionCount(entry),
}));

function contributorSearchText(contributor: (typeof contributors)[number]) {
  return [
    contributorFullName(contributor.data),
    contributor.data.headline,
    contributor.data.shortBio,
    ...contributor.data.affiliations.map((affiliation) => affiliation.name),
    ...contributor.data.expertise,
  ]
    .filter(Boolean)
    .join(' ')
    .toLocaleLowerCase();
}

function compareByActivity(a: (typeof rows)[number], b: (typeof rows)[number]) {
  return (
    b.count - a.count ||
    b.mentions - a.mentions ||
    a.entry.data.lastName.localeCompare(b.entry.data.lastName) ||
    a.entry.data.firstName.localeCompare(b.entry.data.firstName)
  );
}

const featured = [...rows].sort(compareByActivity);
---
<BaseLayout
  title="Contributors"
  description="People contributing articles, solutions, talks, Q&A, and practical expertise to the Decision Management Community."
>
  <h1>Contributors</h1>
  <p class="lede">
    Practitioners, researchers, and community members connected to the Decision Management Community.
    Profiles bring together their work, expertise, affiliations, and public professional links.
  </p>

  <section class="contributor-search" aria-label="Search contributors">
    <label for="contributor-search-input">Search contributors</label>
    <input
      id="contributor-search-input"
      type="search"
      placeholder="Search by name, expertise, affiliation, or biography"
      autocomplete="off"
    />
    <p id="contributor-search-status" class="muted" aria-live="polite">
      Search the contributor directory.
    </p>
  </section>

  {featured.length > 0 && (
    <section class="featured-section" data-contributor-section aria-labelledby="featured-contributors-heading">
      <div class="section-intro">
        <span class="eyebrow">Community work</span>
        <h2 id="featured-contributors-heading">Featured contributors ({featured.length})</h2>
        <p>Contributors with articles, solutions, Q&amp;A, and other work represented across DMCommunity.</p>
      </div>

      <div class="featured-grid">
        {featured.map(({ entry: contributor, count, mentions }) => {
          const name = contributorFullName(contributor.data);
          const isAdam = contributor.id === 'adam-dejans-jr';
          return (
            <article
              class:list={['card', 'featured-card', { 'featured-card-adam': isAdam }]}
              data-contributor
              data-search={contributorSearchText(contributor)}
            >
              <Avatar name={name} image={contributor.data.image} size={88} />
              <div class="contributor-copy">
                <div class="title-row">
                  <h3><a href={url(contributorPath(contributor.id))}>{name}</a></h3>
                  <div class="activity-badges">
                    <span class="contribution-count">{count} indexed {count === 1 ? 'contribution' : 'contributions'}</span>
                    {mentions > 0 && <span class="contribution-count">{mentions} news {mentions === 1 ? 'mention' : 'mentions'}</span>}
                  </div>
                </div>
                <p class="headline">{contributor.data.headline}</p>
                {contributor.data.affiliations.length > 0 && (
                  <p class="muted affiliations">
                    {contributor.data.affiliations.map((affiliation, index) => (
                      <>
                        {index > 0 && ' · '}
                        {affiliation.url ? (
                          <a href={affiliation.url} target="_blank" rel="noopener">{affiliation.name}</a>
                        ) : affiliation.name}
                      </>
                    ))}
                  </p>
                )}
                <p>{contributor.data.shortBio}</p>
                {contributor.data.expertise.length > 0 && (
                  <div class="expertise" aria-label={`${name} expertise`}>
                    {contributor.data.expertise.slice(0, 5).map((item) => <span class="badge">{item}</span>)}
                  </div>
                )}
                <p class="profile-link"><a href={url(contributorPath(contributor.id))}>View contributor profile &rarr;</a></p>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <section class="contributor-note">
    <h2>Expand or correct a profile</h2>
    <p>
      Contributor profiles are community records, not endorsements. To update or correct a profile, please
      <a href="https://github.com/Decision-Management-Community/dm-community/pulls" target="_blank" rel="noopener">open a pull request</a>
      or
      <a href="https://github.com/Decision-Management-Community/dm-community/issues/new" target="_blank" rel="noopener">open an issue</a>.
      These are the preferred ways to request changes. Alternatively, email
      <a href="mailto:DecisionManagementCommunity@gmail.com?subject=Contributor%20profile%20update"> DecisionManagementCommunity@gmail.com</a>
      with an updated biography, affiliation, links, or other corrections.
    </p>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#contributor-search-input');
  const status = document.querySelector<HTMLElement>('#contributor-search-status');
  const contributors = Array.from(document.querySelectorAll<HTMLElement>('[data-contributor]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-contributor-section]'));

  function applySearch() {
    if (!input || !status) return;

    const query = input.value.trim().toLocaleLowerCase();
    let matches = 0;

    contributors.forEach((contributor) => {
      const visible = !query || (contributor.dataset.search ?? '').includes(query);
      contributor.hidden = !visible;
      if (visible) matches += 1;
    });

    sections.forEach((section) => {
      section.hidden = Boolean(query) && !section.querySelector('[data-contributor]:not([hidden])');
    });

    status.textContent = query
      ? `Showing ${matches} ${matches === 1 ? 'contributor' : 'contributors'} matching “${input.value.trim()}”.`
      : 'Search the contributor directory.';
  }

  input?.addEventListener('input', applySearch);

  const adamCard = document.querySelector<HTMLElement>('.featured-card-adam');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (adamCard) {
    const palette = ['#38b6ff', '#6eccff', '#2867b2'];
    let lastSparkAt = 0;

    const spark = (x: number, y: number) => {
      if (reducedMotion.matches) return;
      const now = performance.now();
      if (now - lastSparkAt < 85) return;
      lastSparkAt = now;

      for (let i = 0; i < 4; i += 1) {
        const particle = document.createElement('span');
        const angle = Math.random() * Math.PI * 2;
        const distance = 18 + Math.random() * 28;
        const color = palette[i % palette.length];
        Object.assign(particle.style, {
          position: 'fixed',
          left: `${x}px`,
          top: `${y}px`,
          width: '4px',
          height: '4px',
          borderRadius: '999px',
          background: color,
          boxShadow: `0 0 8px ${color}`,
          pointerEvents: 'none',
          zIndex: '2147483647',
        });
        document.body.appendChild(particle);

        const dx = Math.cos(angle) * distance;
        const dy = Math.sin(angle) * distance;
        particle.animate(
          [
            { transform: 'translate(-50%, -50%) scale(1)', opacity: 0.95 },
            { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0.15)`, opacity: 0 },
          ],
          { duration: 430, easing: 'ease-out', fill: 'forwards' },
        ).finished.finally(() => particle.remove());
      }
    };

    adamCard.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'touch') spark(event.clientX, event.clientY);
    });
    adamCard.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'touch') spark(event.clientX, event.clientY);
    });
  }
</script>

<style>
  .lede { max-width: 56rem; font-size: 1.08rem; line-height: 1.65; }
  .contributor-search {
    max-width: 48rem;
    margin: 1.5rem 0;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card);
  }
  .contributor-search label { display: block; font-weight: 750; }
  .contributor-search input {
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    margin-top: 0.65rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .contributor-search input:focus {
    outline: 3px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    outline-offset: 2px;
  }
  .contributor-search p { margin: 0.7rem 0 0; }
  .featured-section, .community-section { margin-top: 2.4rem; }
  .section-intro { max-width: 54rem; margin-bottom: 1rem; }
  .section-intro h2 { margin: 0.15rem 0 0.45rem; }
  .section-intro p { margin: 0; color: var(--color-text-muted); }
  .eyebrow { color: var(--color-accent-dark); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .featured-grid { display: grid; gap: 1rem; }
  .featured-card { display: flex; gap: 1.25rem; align-items: flex-start; padding: 1.35rem; }
  .featured-card-adam {
    --adam-blue: #38b6ff;
    --adam-blue-dark: #2867b2;
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-color: color-mix(in srgb, var(--color-border) 72%, var(--adam-blue) 28%);
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-card) 95%, var(--adam-blue) 5%), var(--color-card));
    box-shadow: var(--shadow-card), 0 8px 30px rgba(56, 182, 255, 0.08);
    transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s cubic-bezier(0.2, 0.75, 0.25, 1), background-color 0.22s ease;
    animation: adam-card-spotlight 11s ease-in-out infinite;
  }
  .featured-card-adam::after {
    position: absolute;
    top: -1px;
    right: 7%;
    left: 7%;
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--adam-blue), transparent);
    content: '';
    opacity: 0.6;
    pointer-events: none;
    transform: scaleX(0.72);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .featured-card-adam:hover,
  .featured-card-adam:focus-within {
    z-index: 2;
    animation: none;
    border-color: rgba(56, 182, 255, 0.95);
    box-shadow: var(--shadow-card), 0 24px 54px rgba(56, 182, 255, 0.25), 0 0 0 1px rgba(56, 182, 255, 0.18);
    transform: translateY(-5px) scale(1.018);
  }
  .featured-card-adam:hover::after,
  .featured-card-adam:focus-within::after { opacity: 1; transform: scaleX(1); }
  .featured-card-adam h3 a { transition: color 0.2s ease, text-shadow 0.2s ease; }
  .featured-card-adam:hover h3 a,
  .featured-card-adam:focus-within h3 a { color: var(--adam-blue-dark); text-shadow: 0 0 18px rgba(56, 182, 255, 0.22); }
  .featured-card-adam .badge { transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease; }
  .featured-card-adam:hover .badge,
  .featured-card-adam:focus-within .badge { border-color: rgba(56, 182, 255, 0.35); box-shadow: 0 0 12px rgba(56, 182, 255, 0.08); }
  .featured-card-adam:hover .badge:nth-child(odd),
  .featured-card-adam:focus-within .badge:nth-child(odd) { transform: translateY(-1px); }
  @keyframes adam-card-spotlight {
    0%, 68%, 100% { box-shadow: var(--shadow-card), 0 8px 30px rgba(56, 182, 255, 0.08); transform: translateY(0) scale(1); }
    76%, 86% { box-shadow: var(--shadow-card), 0 18px 42px rgba(56, 182, 255, 0.18), 0 0 0 1px rgba(56, 182, 255, 0.14); transform: translateY(-2px) scale(1.006); }
  }
  .contributor-copy { min-width: 0; flex: 1; }
  .title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .featured-card h3 { margin: 0 0 0.25rem; font-size: 1.3rem; }
  .activity-badges { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.35rem; }
  .contribution-count { flex: 0 0 auto; padding: 0.22rem 0.48rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-muted); font-size: 0.72rem; font-weight: 650; }
  .headline { margin: 0.2rem 0; font-weight: 650; }
  .affiliations { margin: 0.2rem 0 0.75rem; }
  .expertise { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.8rem; }
  .profile-link { margin-bottom: 0; }
  .compact-intro { margin-bottom: 1.15rem; }
  .community-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .community-card { display: flex; gap: 0.8rem; align-items: flex-start; min-width: 0; padding: 0.9rem; border: 1px solid var(--color-border); border-radius: 9px; background: var(--color-card); }
  .community-card > div { min-width: 0; }
  .community-card h3 { margin: 0; font-size: 0.98rem; }
  .compact-affiliation { margin: 0.15rem 0; font-size: 0.78rem; }
  .compact-headline { margin: 0.35rem 0; font-size: 0.84rem; line-height: 1.35; }
  .compact-links { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.5rem; font-size: 0.76rem; }
  .contributor-note { margin-top: 2.5rem; padding: 1.25rem 1.4rem; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg-alt); }
  .contributor-note h2 { margin-top: 0; }
  .contributor-note p { margin-bottom: 0; }
  [data-contributor][hidden], [data-contributor-section][hidden] { display: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .featured-card-adam { animation: none; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
    .featured-card-adam:hover,
    .featured-card-adam:focus-within { transform: none; }
  }
  @media (max-width: 900px) { .community-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .featured-card { align-items: flex-start; }
    .title-row { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
    .activity-badges { justify-content: flex-start; }
    .community-grid { grid-template-columns: 1fr; }
  }
</style>