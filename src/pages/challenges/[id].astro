---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { url } from '../../lib/url';
import { authorUrl, canonicalAuthorName } from '../../lib/authorUrl';
import { challengeAuthorEmail } from '../../lib/challengeAuthorEmail';
import { categoryBadgeStyle } from '../../lib/categoryColors';
import { migrateLegacyUrl } from '../../lib/legacyUrl.mjs';

export async function getStaticPaths() {
  const challenges = await getCollection('challenges');
  return challenges.map((c) => ({ params: { id: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function solutionHref(value: string) {
  const migrated = migrateLegacyUrl(value);

  // Prefer self-hosted copies of legacy WordPress uploads when available. If a
  // file was not migrated, preserve the original solution URL instead of
  // silently dropping the link from the challenge page.
  if (migrated.startsWith('/news-media/')) {
    const localMediaPath = join(process.cwd(), 'public', migrated.replace(/^\/+/, ''));
    if (!existsSync(localMediaPath)) return value;
  }

  return migrated.startsWith('/') ? url(migrated) : migrated;
}
---
<BaseLayout title={entry.data.title} description={`Decision Management Community challenge: ${entry.data.title}`}>
  <a href={url('/challenges/')}>&larr; All challenges</a>
  <h1>{entry.data.title}</h1>
  <p class="muted">{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>
  {entry.data.tags.length > 0 && (
    <p>{entry.data.tags.map((t: string) => <span class="badge" style={categoryBadgeStyle(t)}>{t}</span>)}</p>
  )}

  <article class="prose">
    <Content />
  </article>

  {entry.data.solutions.length > 0 && (
    <>
      <h2>Solutions</h2>
      <ul>
        {entry.data.solutions.map((s) => {
          const href = s.url ? solutionHref(s.url) : undefined;
          const external = href?.startsWith('http://') || href?.startsWith('https://');
          const displayAuthor = canonicalAuthorName(s.author);
          const email = challengeAuthorEmail(s.author);
          const profile = authorUrl(displayAuthor);
          const profileExternal = Boolean(profile?.startsWith('http'));
          // A few legacy records list two submitters in one field. Preserve the
          // original wording while restoring a mail link for each known person.
          const authorParts = s.author.split(/( & )/);
          const multipleAuthors = authorParts.length > 1;
          return (
            <li>
              {href ? <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{s.title}</a> : s.title}
              {' — '}
              {multipleAuthors ? authorParts.map((part) => {
                if (part === ' & ') return part;
                const partEmail = challengeAuthorEmail(part);
                const partName = canonicalAuthorName(part);
                return partEmail ? <a href={`mailto:${partEmail}`}>{partName}</a> : partName;
              }) : email ? (
                <a href={`mailto:${email}`}>{displayAuthor}</a>
              ) : profile ? (
                <a href={profile} target={profileExternal ? '_blank' : undefined} rel={profileExternal ? 'noopener' : undefined}>{displayAuthor}</a>
              ) : displayAuthor}
              {s.affiliation ? ` (${s.affiliation})` : ''}
            </li>
          );
        })}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  .badge { margin-right: 0.4rem; }
</style>
