---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';
import { categoryBadgeStyle } from '../../lib/categoryColors';

export async function getStaticPaths() {
  const challenges = await getCollection('challenges');
  return challenges.map((c) => ({ params: { id: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={`Decision Management Community challenge: ${entry.data.title}`}>
  <a href={url('/challenges/')}>&larr; All challenges</a>
  <h1>{entry.data.title}</h1>
  <p class="muted">{entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>
  {entry.data.tags.length > 0 && (
    <p>{entry.data.tags.map((t: string) => <span class="badge" style={categoryBadgeStyle(t)}>{t}</span>)}</p>
  )}

  <article class="prose">
    <Content />
  </article>

  {entry.data.solutions.length > 0 && (
    <>
      <h2>Solutions</h2>
      <ul>
        {entry.data.solutions.map((s) => (
          <li>
            {s.url ? <a href={s.url} target="_blank" rel="noopener">{s.title}</a> : s.title}
            {' — '}{s.author}{s.affiliation ? ` (${s.affiliation})` : ''}
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>

<style>
  .badge { margin-right: 0.4rem; }
</style>
