---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'contribute');
const { Content } = await render(entry!);

const repoUrl = 'https://github.com/Decision-Management-Community/dm-community';
const contentUrl = `${repoUrl}/tree/main/src/content`;
const contributingUrl = `${repoUrl}/blob/main/CONTRIBUTING.md`;
---
<BaseLayout title="Contribute" description={entry?.data.description}>
  <section class="contribute-hero">
    <span class="eyebrow">Open-source community</span>
    <h1>Put something useful back into the community.</h1>
    <p class="hero-copy">
      Share a model, article, case study, tool, challenge, event, correction, or code improvement.
      You do not need to be a developer, and you do not need permission before you start.
    </p>
    <div class="hero-actions">
      <a class="primary-action" href={repoUrl} target="_blank" rel="noopener">Contribute on GitHub <span aria-hidden="true">↗</span></a>
      <a class="secondary-action" href="/contribute/open-an-issue/">How to open an issue</a>
      <a class="secondary-action" href={contributingUrl} target="_blank" rel="noopener">Read the full guide</a>
    </div>
    <div class="hero-notes" aria-label="Contribution highlights">
      <span>No code required for content</span>
      <span>Automated validation</span>
      <span>Reviewed in public</span>
    </div>
  </section>

  <section class="paths-section" aria-labelledby="paths-heading">
    <div class="section-heading">
      <span class="eyebrow">Choose a starting point</span>
      <h2 id="paths-heading">How do you want to contribute?</h2>
    </div>

    <div class="contribution-paths">
      <a class="path" href={`${contentUrl}/articles`} target="_blank" rel="noopener">
        <span class="path-number" aria-hidden="true">01</span>
        <div>
          <h3>Share knowledge</h3>
          <p>Articles, case studies, Q&A, challenges, and practical lessons from the field.</p>
          <span class="path-link">Browse content folders →</span>
        </div>
      </a>

      <a class="path" href={`${contentUrl}/tools`} target="_blank" rel="noopener">
        <span class="path-number" aria-hidden="true">02</span>
        <div>
          <h3>Add a resource</h3>
          <p>Tools, decision models, books, events, and other material practitioners should know about.</p>
          <span class="path-link">See resource formats →</span>
        </div>
      </a>

      <a class="path" href="/contribute/open-an-issue/">
        <span class="path-number" aria-hidden="true">03</span>
        <div>
          <h3>Suggest an improvement</h3>
          <p>Found a broken link, confusing page, missing resource, or idea for making the site better? You do not need to know how to code.</p>
          <span class="path-link">Learn how to open an issue →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="process-section" aria-labelledby="process-heading">
    <div class="section-heading">
      <span class="eyebrow">Simple by design</span>
      <h2 id="process-heading">From idea to merged contribution</h2>
    </div>

    <ol class="process-list">
      <li><span class="step">1</span><div><strong>Pick the right folder.</strong><p>Every content type under <code>src/content/</code> has a README with its exact format and an example.</p></div></li>
      <li><span class="step">2</span><div><strong>Add or edit a Markdown file.</strong><p>For content, you can do the entire thing in GitHub's web interface. Cloning the repo is optional.</p></div></li>
      <li><span class="step">3</span><div><strong>Open a pull request.</strong><p>Describe what you added or changed. A draft PR is completely fine if you want feedback first.</p></div></li>
      <li><span class="step">4</span><div><strong>Let the checks run.</strong><p>The site builds automatically and validates required fields, links, and metadata.</p></div></li>
      <li><span class="step">5</span><div><strong>A maintainer reviews it.</strong><p>Useful contributions get merged; unclear ones get a question or a suggested adjustment rather than disappearing into a queue.</p></div></li>
    </ol>
  </section>

  <div class="details-layout">
    <article class="prose contribution-details">
      <Content />
    </article>

    <aside class="quick-start" aria-label="Quick contribution links">
      <span class="eyebrow">Quick links</span>
      <h2>Start here</h2>
      <a href={contentUrl} target="_blank" rel="noopener"><strong>Content folders</strong><span>Find the format for your contribution.</span></a>
      <a href="/contribute/open-an-issue/"><strong>How to open an issue</strong><span>Step-by-step visual guide for reporting a problem or suggesting a change.</span></a>
      <a href={contributingUrl} target="_blank" rel="noopener"><strong>CONTRIBUTING.md</strong><span>Full workflow, rules, and folder reference.</span></a>
      <a href="mailto:DecisionManagementCommunity@gmail.com"><strong>Email the community</strong><span>Useful when GitHub is not the right starting point.</span></a>
    </aside>
  </div>
</BaseLayout>

<style>
  .contribute-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4.2rem);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background:
      radial-gradient(circle at 88% 8%, color-mix(in srgb, var(--color-accent) 20%, transparent), transparent 30%),
      linear-gradient(135deg, color-mix(in srgb, var(--color-card) 96%, var(--color-primary) 4%), var(--color-card));
    box-shadow: var(--shadow-card);
  }
  .contribute-hero::after {
    content: '+';
    position: absolute;
    right: clamp(1rem, 5vw, 3rem);
    bottom: -4.2rem;
    color: color-mix(in srgb, var(--color-text) 4%, transparent);
    font-family: var(--font-sans);
    font-size: clamp(10rem, 24vw, 18rem);
    font-weight: 200;
    line-height: 1;
    pointer-events: none;
  }
  .eyebrow {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--color-accent-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .contribute-hero h1 {
    position: relative;
    z-index: 1;
    max-width: 17ch;
    margin: 0;
    font-size: clamp(2.1rem, 5vw, 3.65rem);
    letter-spacing: -0.035em;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 66ch;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.06rem;
  }
  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.65rem 0.95rem;
    border-radius: 8px;
    font-size: 0.86rem;
    font-weight: 750;
    text-decoration: none;
  }
  .primary-action {
    border: 1px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-bg);
  }
  .secondary-action {
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card) 86%, transparent);
    color: var(--color-text);
  }
  .primary-action:hover,
  .secondary-action:hover { text-decoration: none; transform: translateY(-1px); }
  .hero-notes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.76rem;
  }
  .hero-notes span::before {
    content: '✓';
    margin-right: 0.35rem;
    color: var(--color-accent-dark);
    font-weight: 800;
  }

  .paths-section,
  .process-section { margin-top: 3rem; }
  .section-heading { margin-bottom: 1rem; }
  .section-heading h2 { margin: 0; }

  .contribution-paths {
    border-top: 1px solid var(--color-border);
  }
  .path {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 1rem;
    padding: 1.15rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
    transition: padding-left 0.18s ease, background 0.18s ease;
  }
  .path:hover {
    padding-left: 0.8rem;
    background: color-mix(in srgb, var(--color-bg-alt) 70%, transparent);
    text-decoration: none;
  }
  .path-number {
    padding-top: 0.15rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .path h3 { margin: 0 0 0.2rem; font-family: var(--font-sans); font-size: 1rem; }
  .path p { max-width: 72ch; margin: 0; color: var(--color-text-muted); font-size: 0.87rem; }
  .path-link { display: inline-block; margin-top: 0.4rem; color: var(--color-primary); font-size: 0.78rem; font-weight: 700; }

  .process-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-card);
  }
  .process-list li {
    min-width: 0;
    padding: 1rem;
    border-right: 1px solid var(--color-border);
  }
  .process-list li:last-child { border-right: 0; }
  .step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    margin-bottom: 0.75rem;
    border-radius: 999px;
    background: var(--color-bg-alt);
    color: var(--color-accent-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
  }
  .process-list strong { display: block; font-size: 0.86rem; line-height: 1.35; }
  .process-list p { margin: 0.35rem 0 0; color: var(--color-text-muted); font-size: 0.76rem; line-height: 1.5; }
  .process-list code { font-size: 0.72rem; }

  .details-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 3rem;
    align-items: start;
    margin-top: 3rem;
  }
  .contribution-details :global(h2:first-child) { margin-top: 0; }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) { max-width: 72ch; }
  .prose :global(li) { margin-bottom: 0.35rem; }

  .quick-start {
    position: sticky;
    top: 84px;
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
  }
  .quick-start h2 { margin: 0 0 0.65rem; font-family: var(--font-sans); font-size: 1rem; }
  .quick-start a {
    display: block;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }
  .quick-start a:last-child { border-bottom: 0; }
  .quick-start a:hover strong { color: var(--color-primary); }
  .quick-start strong { display: block; font-size: 0.82rem; }
  .quick-start span { display: block; margin-top: 0.1rem; color: var(--color-text-muted); font-size: 0.72rem; line-height: 1.4; }

  @media (max-width: 900px) {
    .process-list { grid-template-columns: 1fr; }
    .process-list li { display: grid; grid-template-columns: 38px 1fr; gap: 0.7rem; border-right: 0; border-bottom: 1px solid var(--color-border); }
    .process-list li:last-child { border-bottom: 0; }
    .step { margin: 0; }
    .details-layout { grid-template-columns: 1fr; gap: 1.5rem; }
    .quick-start { position: static; padding: 1rem 0 0; border-left: 0; border-top: 1px solid var(--color-border); }
  }

  @media (max-width: 560px) {
    .contribute-hero { padding: 1.6rem; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .path { grid-template-columns: 36px minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .path,
    .primary-action,
    .secondary-action { transition: none; }
    .path:hover,
    .primary-action:hover,
    .secondary-action:hover { transform: none; }
  }
</style>
