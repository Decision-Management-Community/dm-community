---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('events')).sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
const now = Date.now();
const upcoming = all.filter((e) => e.data.startDate.valueOf() >= now);
const past = all.filter((e) => e.data.startDate.valueOf() < now).reverse();

function fmt(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<BaseLayout title="Events" description="Upcoming and past events for the Decision Management Community.">
  <h1>Events</h1>

  <h2>Upcoming</h2>
  {upcoming.length > 0 ? (
    <div class="card-grid">
      {upcoming.map((e) => (
        <div class="card">
          <h3><a href={e.data.url} target="_blank" rel="noopener">{e.data.title}</a></h3>
          <p class="muted">{fmt(e.data.startDate)}{e.data.endDate ? ` – ${fmt(e.data.endDate)}` : ''}</p>
          {e.data.location && <p class="muted">{e.data.location}</p>}
        </div>
      ))}
    </div>
  ) : <p class="muted">No upcoming events listed yet.</p>}

  {past.length > 0 && (
    <>
      <h2>Past</h2>
      <table>
        <thead><tr><th>Event</th><th>Date</th><th>Location</th></tr></thead>
        <tbody>
          {past.map((e) => (
            <tr>
              <td><a href={e.data.url} target="_blank" rel="noopener">{e.data.title}</a></td>
              <td>{fmt(e.data.startDate)}</td>
              <td>{e.data.location}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <p class="muted">Know of an event the community should list? <a href="https://github.com/Decision-Management-Community/dm-community/blob/main/CONTRIBUTING.md">Open a pull request</a>.</p>
</BaseLayout>
