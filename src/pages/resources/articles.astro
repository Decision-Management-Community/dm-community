---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { authorUrl, canonicalAuthorName } from '../../lib/authorUrl';
import { url } from '../../lib/url';
import { getGiscusArticleComments } from '../../lib/giscusCommentCounts.mjs';

const posts = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const giscusCommentsByArticle = await getGiscusArticleComments();

const authorCounts = new Map<string, number>();
for (const post of posts) {
  const displayAuthor = canonicalAuthorName(post.data.author);
  if (displayAuthor) {
    authorCounts.set(displayAuthor, (authorCounts.get(displayAuthor) ?? 0) + 1);
  }
}
const authors = [...authorCounts.keys()].sort((a, b) => a.localeCompare(b));
---
<BaseLayout title="Articles" description="Decision Management articles and archived challenge solution documents.">
  <h1>Articles</h1>
  <p>
    Writing on Decision Management — the science, the philosophy, and more. Long-form essays and
    archived challenge solution documents from practitioners in the community.
  </p>

  <div class="archive-tools">
    <label>
      <span>Search articles</span>
      <input id="article-search" type="search" placeholder="Search titles, authors, summaries, and comments" autocomplete="off" />
    </label>
    <label>
      <span>Author</span>
      <select id="article-author">
        <option value="">All authors</option>
        {authors.map((author) => <option value={author}>{author} ({authorCounts.get(author)})</option>)}
      </select>
    </label>
    <label>
      <span>Comments</span>
      <select id="article-comments">
        <option value="">All articles</option>
        <option value="with-comments">With comments</option>
      </select>
    </label>
    <p id="article-count" class="muted" aria-live="polite">
      {posts.length} {posts.length === 1 ? 'article' : 'articles'}
    </p>
  </div>

  <div id="article-archive" class="card-grid">
    {posts.map((p) => {
      const displayAuthor = canonicalAuthorName(p.data.author);
      const profile = authorUrl(displayAuthor, p.data.linkedin);
      const giscusComments = giscusCommentsByArticle[p.id];
      const commentCount = giscusComments?.count ?? 0;
      return (
        <article
          class="card article-card"
          data-search={`${p.data.title} ${displayAuthor ?? ''} ${p.data.summary ?? ''} ${giscusComments?.searchText ?? ''}`.toLocaleLowerCase()}
          data-author={displayAuthor ?? ''}
          data-comment-count={commentCount}
        >
          <h3><a href={url(`/resources/articles/${p.id}/`)}>{p.data.title}</a></h3>
          <p class="muted small">
            {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            {displayAuthor && (
              <>
                {' · '}
                {profile ? (
                  <a href={profile} target="_blank" rel="noopener">{displayAuthor}</a>
                ) : displayAuthor}
              </>
            )}
          </p>
          {p.data.summary && <p>{p.data.summary}</p>}
          {commentCount > 0 && (
            <p class="comment-count" aria-label={`${commentCount} ${commentCount === 1 ? 'comment' : 'comments'}`}>
              {commentCount} {commentCount === 1 ? 'comment' : 'comments'}
            </p>
          )}
        </article>
      );
    })}
  </div>

  <button id="article-more" class="show-more" type="button" hidden>Show more articles</button>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = [...document.querySelectorAll('.article-card')];
    const search = document.querySelector('#article-search');
    const author = document.querySelector('#article-author');
    const comments = document.querySelector('#article-comments');
    const count = document.querySelector('#article-count');
    const more = document.querySelector('#article-more');
    const pageSize = 60;
    let limit = pageSize;

    const apply = () => {
      const query = search.value.trim().toLocaleLowerCase();
      const selectedAuthor = author.value;
      const commentsOnly = comments.value === 'with-comments';
      const matches = cards.filter((card) =>
        (!query || card.dataset.search.includes(query)) &&
        (!selectedAuthor || card.dataset.author === selectedAuthor) &&
        (!commentsOnly || Number(card.dataset.commentCount) > 0),
      );
      const matchSet = new Set(matches);
      let shown = 0;

      for (const card of cards) {
        const visible = matchSet.has(card) && shown < limit;
        card.hidden = !visible;
        if (visible) shown += 1;
      }

      count.textContent = `Showing ${shown} of ${matches.length} matching articles (${cards.length} total)`;
      more.hidden = shown >= matches.length;
    };

    search.addEventListener('input', () => { limit = pageSize; apply(); });
    author.addEventListener('change', () => { limit = pageSize; apply(); });
    comments.addEventListener('change', () => { limit = pageSize; apply(); });
    more.addEventListener('click', () => { limit += pageSize; apply(); });
    apply();
  });
</script>

<style>
  .small { font-size: 0.8rem; }
  .comment-count { margin: 0.8rem 0 0; color: var(--color-text-muted); font-size: 0.8rem; font-weight: 600; }
  .archive-tools {
    display: grid;
    grid-template-columns: minmax(16rem, 2fr) minmax(12rem, 1fr) minmax(11rem, 1fr);
    gap: 0.9rem 1rem;
    align-items: end;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-alt);
  }
  .archive-tools label { display: grid; gap: 0.35rem; font-weight: 600; }
  .archive-tools input,
  .archive-tools select {
    width: 100%;
    min-height: 2.6rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .archive-tools p { grid-column: 1 / -1; margin: 0; }
  .show-more {
    display: block;
    margin: 2rem auto;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-alt);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  [hidden] { display: none !important; }
  @media (max-width: 640px) {
    .archive-tools { grid-template-columns: 1fr; }
  }
</style>
