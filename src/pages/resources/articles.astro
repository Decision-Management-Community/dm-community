---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const posts = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout title="Articles" description="Decision Management articles on the science, philosophy, and practice of better decisions.">
  <h1>Articles</h1>
  <p>
    Writing on Decision Management — the science, the philosophy, and more. Long-form essays from
    practitioners in the community.
  </p>

  <div class="card-grid">
    {posts.map((p) => (
      <div class="card">
        <h3><a href={url(`/resources/articles/${p.id}/`)}>{p.data.title}</a></h3>
        <p class="muted small">
          {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          {p.data.author && (
            <>
              {' · '}
              {p.data.linkedin ? (
                <a href={p.data.linkedin} target="_blank" rel="noopener">{p.data.author}</a>
              ) : p.data.author}
            </>
          )}
        </p>
        {p.data.summary && <p>{p.data.summary}</p>}
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .small { font-size: 0.8rem; }
</style>
