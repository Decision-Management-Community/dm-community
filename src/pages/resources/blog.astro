---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout title="Blog" description="Essays on policy, decision factories, and thinking through tradeoffs before the pressure shows up.">
  <h1>Blog</h1>
  <p>
    Essays on decision management — what a policy actually is, how decision factories work, and
    why the hard tradeoffs are better made while you still have a clear head.
  </p>

  <div class="card-grid">
    {posts.map((p) => (
      <div class="card">
        <h3><a href={url(`/resources/blog/${p.id}/`)}>{p.data.title}</a></h3>
        <p class="muted small">
          {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          {p.data.author && (
            <>
              {' · '}
              {p.data.linkedin ? (
                <a href={p.data.linkedin} target="_blank" rel="noopener">{p.data.author}</a>
              ) : p.data.author}
            </>
          )}
        </p>
        {p.data.summary && <p>{p.data.summary}</p>}
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .small { font-size: 0.8rem; }
</style>
