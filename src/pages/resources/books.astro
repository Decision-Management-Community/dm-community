---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { url } from '../../lib/url';

const entry = await getEntry('pages', 'resources-books');

const descriptions: Record<string, string> = {
  'Bridging Decision Problems, Volume I: Framing the Problem':
    'A practical framework for defining the decision, objectives, uncertainties, and alternatives before modeling begins.',
  'The Decision Factory: A Novel about Decisions Under Uncertainty':
    'A practitioner-oriented novel about turning uncertain information into policies, simulations, and better operational decisions.',
  'The MILP Optimization Handbook for Practitioners':
    'A hands-on guide to building practical mixed-integer linear optimization models for real-world decisions.',
  'Business Decision Modeling with OpenRules':
    'A practical introduction to creating, testing, and deploying operational business decision models with OpenRules.',
  'Real-World Decision Modeling with DMN':
    'A practitioner guide to modeling business decisions with DMN using real-world examples and disciplined notation.',
  'CMMN Method and Style':
    'A structured guide to modeling case-management work clearly and consistently with CMMN.',
  'Business Knowledge Blueprints':
    'A method for organizing business knowledge, rules, and concepts into reusable structures for operational decisions.',
  'Digital Decisioning: Using Decision Management to Deliver Business Impact from AI':
    'A business-focused guide to applying decision management and AI to repeatable operational decisions.',
  'Goal-Oriented Decision Modeling with OpenRules':
    'A goal-driven approach to structuring, testing, and automating business decisions with OpenRules.',
  'DMN Method and Style':
    'A practical style guide for creating clear, consistent, and executable DMN models.',
  'DMN Cookbook':
    'A collection of practical DMN patterns and examples for common decision-modeling situations.',
  'DMN in Action with OpenRules':
    'Hands-on examples of representing and executing DMN-based decision models with OpenRules.',
  'Systems of Insight for Digital Transformation':
    'An IBM Redbook on operationalizing analytics and decision capabilities as part of digital transformation.',
  'The Microguide to Process and Decision Modeling in BPMN/DMN':
    'A compact guide to combining process models in BPMN with decision models in DMN.',
  'Knowledge Automation':
    'A practical look at capturing expert knowledge and turning it into automated business decisions.',
  'Building Business Solutions':
    'A business-rules-oriented approach to designing solutions around business knowledge, vocabulary, and requirements.',
  'The Decision Model':
    'Introduces a structured method for separating, organizing, and managing business decision logic.',
  'Smart Enough Systems':
    'A foundational guide to embedding analytics and decision automation directly into operational systems.',
  'Domain-Driven Design':
    'The classic guide to modeling complex business domains in software through a shared language and domain model.',
  'The Goal: A Process of Ongoing Improvement':
    'A management novel introducing Theory of Constraints and systems thinking through manufacturing operations.',
  'Modeling the World in States':
    'A foundational object-oriented analysis text focused on modeling system behavior through states and transitions.',
  'Modeling the World in Data':
    'A foundational data-modeling text focused on representing real-world entities, relationships, and information structures.',
};

const localBookCovers: Record<string, string> = {
  'Bridging Decision Problems, Volume I: Framing the Problem': '/books/bridging-decision-problems-vol-1.webp',
  'The Decision Factory: A Novel about Decisions Under Uncertainty': '/books/the-decision-factory.webp',
  'The MILP Optimization Handbook for Practitioners': '/books/milp-optimization-handbook.webp',
  'Business Decision Modeling with OpenRules': '/books/business-decision-modeling-openrules.webp',
};

// Explicitly verified Google Books volume IDs. We intentionally do not infer
// cover IDs from Amazon ASINs: many modern ASINs are not ISBNs, and guessed
// Open Library URLs produced missing or broken images.
const googleBooksCoverIds: Record<string, string> = {
  'Real-World Decision Modeling with DMN|2023': 'bdUN0AEACAAJ',
  'Business Knowledge Blueprints|2020': 'U5bjygEACAAJ',
  'DMN Method and Style|2018': 'ckaZvAEACAAJ',
  'Real-World Decision Modeling with DMN|2016': 'fPwTMQAACAAJ',
  'The Microguide to Process and Decision Modeling in BPMN/DMN|2014': '7Ry9oQEACAAJ',
  'Knowledge Automation|2012': 'q9E0xXgfPJMC',
  'Building Business Solutions|2011': 'FONJMwEACAAJ',
  'The Decision Model|2010': 'rzdnmAEACAAJ',
  'Smart Enough Systems|2007': '4aVDDQEACAAJ',
  'Domain-Driven Design|2003': '7dlaMs0SECsC',
  'The Goal: A Process of Ongoing Improvement|1992': '0T5EAAAAMAAJ',
};

function coverUrlFor(title: string, year: number) {
  const localCover = localBookCovers[title];
  if (localCover) return url(localCover);

  const id = googleBooksCoverIds[`${title}|${year}`];
  return id
    ? `https://books.google.com/books/content?id=${id}&printsec=frontcover&img=1&zoom=1&source=gbs_api`
    : undefined;
}

function compactTitle(title: string) {
  return title.length > 46 ? `${title.slice(0, 43).trim()}…` : title;
}

function compactAuthor(author: string) {
  return author.length > 28 ? `${author.slice(0, 25).trim()}…` : author;
}

const books = (entry?.body ?? '')
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => /^\d+\.\s/.test(line))
  .map((line, index) => {
    const match = line.match(/^\d+\.\s+\[\*(.+?)\*\]\(([^)]+)\)(.*?)\s+—\s+(.+?)\s+\((\d{4})\)\s*$/);
    if (!match) return null;
    const [, title, href, rawNote, author, rawYear] = match;
    const year = Number(rawYear);
    return {
      rank: index + 1,
      title,
      href,
      note: rawNote.trim(),
      author,
      year,
      decade: `${Math.floor(year / 10) * 10}s`,
      description: descriptions[title] ?? 'A community-recommended book related to decision management and decision-making practice.',
      coverUrl: coverUrlFor(title, year),
      coverTitle: compactTitle(title),
      coverAuthor: compactAuthor(author),
    };
  })
  .filter((book): book is NonNullable<typeof book> => Boolean(book));

const decades = [...new Set(books.map((book) => book.decade))].sort((a, b) => Number(b.slice(0, 4)) - Number(a.slice(0, 4)));
const newestYear = books[0]?.year;
const oldestYear = books.at(-1)?.year;
---
<BaseLayout title="Books" description={entry?.data.description}>
  <section class="books-hero">
    <span class="eyebrow">Community reading shelf</span>
    <h1>Books for Better Decisions</h1>
    <p class="lede muted">
      A practitioner-curated library spanning decision modeling, business rules, optimization,
      knowledge systems, and the foundations that shaped modern Decision Management.
    </p>
    <div class="book-stats" aria-label="Book library statistics">
      <div><strong>{books.length}</strong><span>titles</span></div>
      <div><strong>{decades.length}</strong><span>decades</span></div>
      {newestYear && oldestYear && <div><strong>{oldestYear}–{newestYear}</strong><span>publication years</span></div>}
    </div>
  </section>

  <section class="library-section">
    <div class="section-heading library-heading">
      <div>
        <span class="eyebrow">Full library</span>
        <h2>Browse the shelf</h2>
      </div>
      <span id="book-count" class="muted small">{books.length} books</span>
    </div>

    <div class="book-controls" role="search" aria-label="Filter books">
      <label class="search-field">
        <span class="sr-only">Search books</span>
        <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.5" />
          <path d="M12 12L16 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <input id="book-search" type="search" placeholder="Search title, author, or topic…" autocomplete="off" />
      </label>
      <label class="decade-field">
        <span class="sr-only">Filter by decade</span>
        <select id="book-decade">
          <option value="all">All decades</option>
          {decades.map((decade) => <option value={decade}>{decade}</option>)}
        </select>
      </label>
    </div>

    <div id="book-library" class="book-library">
      {books.map((book) => (
        <article
          class="book-row"
          data-book
          data-search={`${book.title} ${book.author} ${book.year} ${book.description}`.toLowerCase()}
          data-decade={book.decade}
        >
          <span class="book-number" aria-hidden="true">{String(book.rank).padStart(2, '0')}</span>
          <div class="book-cover-slot" aria-hidden="true">
            <span class="book-cover-fallback">
              <span class="fallback-rule"></span>
              <span class="fallback-title">{book.coverTitle}</span>
              <span class="fallback-author">{book.coverAuthor}</span>
            </span>
            {book.coverUrl && (
              <img
                class="book-cover"
                src={book.coverUrl}
                alt=""
                loading="lazy"
                referrerpolicy="no-referrer"
                onerror="this.hidden=true"
              />
            )}
          </div>
          <div class="book-info">
            <h3><a href={book.href} target="_blank" rel="noopener">{book.title}</a></h3>
            <p class="book-author muted">{book.author}</p>
            <p class="book-description">{book.description}</p>
          </div>
          {book.note && <span class="edition-pill">{book.note}</span>}
          <span class="year-pill">{book.year}</span>
        </article>
      ))}
    </div>
    <p id="book-empty" class="book-empty muted" hidden>No books match that search yet.</p>

    <p class="contribute-note muted">
      Missing a book that belongs here? <a href="https://github.com/Decision-Management-Community/dm-community/blob/main/src/content/pages/resources-books.md">Propose an addition on GitHub</a>.
      <span class="cover-credit"> Verified third-party cover images are served by <a href="https://books.google.com/" target="_blank" rel="noopener">Google Books</a>; every title has a local visual fallback.</span>
    </p>
  </section>
</BaseLayout>

<style>
  .books-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background:
      radial-gradient(circle at 92% 12%, color-mix(in srgb, var(--color-accent) 24%, transparent), transparent 32%),
      radial-gradient(circle at 8% 100%, color-mix(in srgb, var(--color-primary) 15%, transparent), transparent 35%),
      var(--color-card);
    box-shadow: var(--shadow-card);
  }
  .books-hero::after {
    content: 'READ · THINK · DECIDE';
    position: absolute;
    right: -1rem;
    bottom: 0.2rem;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.8;
    color: color-mix(in srgb, var(--color-text) 4%, transparent);
    pointer-events: none;
    white-space: nowrap;
  }
  .eyebrow {
    display: block;
    color: var(--color-accent-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }
  .books-hero h1 { margin: 0; max-width: 14ch; }
  .lede { max-width: 65ch; font-size: 1.08rem; }
  .book-stats {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .book-stats div {
    min-width: 120px;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-card) 86%, transparent);
    backdrop-filter: blur(5px);
  }
  .book-stats strong { display: block; font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.1; }
  .book-stats span { color: var(--color-text-muted); font-size: 0.72rem; }

  .library-section { margin-top: 3rem; }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .section-heading h2 { margin: 0; }
  .small { font-size: 0.8rem; }

  .book-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.7rem;
    margin-bottom: 1rem;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-card);
    color: var(--color-text-muted);
  }
  .search-field:focus-within { border-color: var(--color-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 16%, transparent); }
  .search-field input {
    width: 100%;
    min-height: 44px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
  }
  .decade-field select {
    min-height: 46px;
    padding: 0 2.2rem 0 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-card);
    color: var(--color-text);
    font: inherit;
  }

  .book-library {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }
  .book-row {
    display: grid;
    grid-template-columns: 36px 58px minmax(0, 1fr) auto 58px;
    gap: 0.9rem;
    align-items: center;
    padding: 0.82rem 0.6rem;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.15s ease, padding-left 0.15s ease;
  }
  .book-row:hover { background: color-mix(in srgb, var(--color-bg-alt) 72%, transparent); padding-left: 0.8rem; }
  .book-row[hidden] { display: none; }
  .book-number { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.72rem; }

  .book-cover-slot {
    position: relative;
    width: 56px;
    height: 80px;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-bg-alt);
    box-shadow: 0 2px 7px rgba(15, 23, 42, 0.13);
  }
  .book-cover-fallback,
  .book-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .book-cover {
    z-index: 2;
    display: block;
    object-fit: cover;
    background: var(--color-bg-alt);
  }
  .book-cover-fallback {
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.42rem 0.38rem;
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--color-brand) 90%, #000 10%), var(--color-primary-dark));
    color: #f8fafc;
  }
  .fallback-rule {
    width: 18px;
    height: 2px;
    background: color-mix(in srgb, var(--color-accent) 88%, #fff 12%);
  }
  .fallback-title {
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: 0.51rem;
    font-weight: 700;
    line-height: 1.15;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
  }
  .fallback-author {
    display: block;
    overflow: hidden;
    font-size: 0.38rem;
    font-weight: 600;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.82;
  }

  .book-info h3 { margin: 0; font-family: var(--font-sans); font-size: 0.96rem; line-height: 1.35; }
  .book-author { margin: 0.12rem 0 0; font-size: 0.8rem; }
  .book-description {
    max-width: 76ch;
    margin: 0.28rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.79rem;
    line-height: 1.45;
  }
  .year-pill,
  .edition-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    white-space: nowrap;
  }
  .year-pill { font-family: var(--font-mono); }
  .edition-pill { max-width: 190px; overflow: hidden; text-overflow: ellipsis; }
  .book-empty { text-align: center; padding: 2rem 0; }
  .contribute-note { font-size: 0.82rem; margin-top: 1.25rem; }
  .cover-credit { margin-left: 0.25rem; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .books-hero { padding: 1.6rem; }
    .book-controls { grid-template-columns: 1fr; }
    .decade-field select { width: 100%; }
    .book-row { grid-template-columns: 56px minmax(0, 1fr) auto; }
    .book-number,
    .edition-pill { display: none; }
  }

  @media (max-width: 500px) {
    .section-heading { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
    .book-row { grid-template-columns: 46px minmax(0, 1fr); gap: 0.75rem; }
    .book-cover-slot { width: 44px; height: 64px; }
    .book-description { font-size: 0.76rem; }
    .year-pill { grid-column: 2; justify-self: start; }
  }
</style>

<script>
  const search = document.getElementById('book-search') as HTMLInputElement | null;
  const decade = document.getElementById('book-decade') as HTMLSelectElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-book]'));
  const count = document.getElementById('book-count');
  const empty = document.getElementById('book-empty');

  function filterBooks() {
    const query = search?.value.trim().toLowerCase() ?? '';
    const selectedDecade = decade?.value ?? 'all';
    let visible = 0;

    rows.forEach((row) => {
      const matchesSearch = !query || (row.dataset.search ?? '').includes(query);
      const matchesDecade = selectedDecade === 'all' || row.dataset.decade === selectedDecade;
      const show = matchesSearch && matchesDecade;
      row.hidden = !show;
      if (show) visible += 1;
    });

    if (count) count.textContent = `${visible} book${visible === 1 ? '' : 's'}`;
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener('input', filterBooks);
  decade?.addEventListener('change', filterBooks);
</script>