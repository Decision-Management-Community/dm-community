---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const categoryKeys = ['BR', 'ML', 'OPT', 'LLM'] as const;
const categoryInfo = {
  BR: { label: 'Business Rules', color: '#2563eb' },
  ML: { label: 'Machine Learning', color: '#16815d' },
  OPT: { label: 'Optimization', color: '#c05b12' },
  LLM: { label: 'Agentic AI', color: '#7c3aed' },
} as const;
---
<BaseLayout title="Tools" description="Business rules, machine learning, optimization, and Agentic AI tools for decision management.">
  <h1>Tools</h1>
  <p>
    A community-maintained catalog of decision management tooling. All tools are classified by the
    four functional categories below.
  </p>
  <p>
    Missing your tool or want to adjust its description?
    <a href="https://github.com/Decision-Management-Community/dm-community/blob/main/CONTRIBUTING.md#adding-a-tool">Do it via pull request</a>.
  </p>

  <div class="tool-filters" role="group" aria-label="Filter tools by functional category">
    <button type="button" data-tool-filter="" aria-pressed="true">All</button>
    {categoryKeys.map((key) => (
      <button type="button" data-tool-filter={key} aria-pressed="false" style={`--filter-color:${categoryInfo[key].color}`}>
        <strong>{key}</strong><span>{categoryInfo[key].label}</span>
      </button>
    ))}
  </div>
  <p id="tool-count" class="muted" aria-live="polite">Showing {all.length} tools</p>

  <div class="card-grid" id="tool-list">
    {all.map((tool) => (
      <article class="card tool-card" data-tool data-categories={tool.data.categories.join(' ')}>
        <h2>{tool.data.url ? <a href={tool.data.url} target="_blank" rel="noopener">{tool.data.name}</a> : tool.data.name}</h2>
        <div class="tool-categories" aria-label="Supported categories">
          {tool.data.categories.map((key) => (
            <span class="tool-category" style={`--category-color:${categoryInfo[key].color}`} title={categoryInfo[key].label}>
              {key}
            </span>
          ))}
        </div>
        {tool.data.summary && <p class="muted">{tool.data.summary}</p>}
      </article>
    ))}
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = [...document.querySelectorAll('[data-tool-filter]')];
    const cards = [...document.querySelectorAll('[data-tool]')];
    const count = document.querySelector('#tool-count');

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const selected = button.dataset.toolFilter || '';
        let visible = 0;
        for (const candidate of buttons) candidate.setAttribute('aria-pressed', String(candidate === button));
        for (const card of cards) {
          const categories = (card.dataset.categories || '').split(' ');
          card.hidden = Boolean(selected) && !categories.includes(selected);
          if (!card.hidden) visible += 1;
        }
        count.textContent = selected
          ? `Showing ${visible} of ${cards.length} tools supporting ${selected}`
          : `Showing ${cards.length} tools`;
      });
    }
  });
</script>

<style>
  .tool-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0.75rem;
  }
  .tool-filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--filter-color, var(--color-text-muted));
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
  .tool-filters button[aria-pressed='true'] {
    background: var(--color-bg-alt);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--filter-color, var(--color-text)) 35%, transparent);
  }
  .tool-filters button span { color: var(--color-text-muted); }
  .tool-card { border-top: 3px solid var(--color-border); }
  .tool-card h2 { margin-top: 0; font-size: 1.15rem; }
  .tool-categories { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.5rem 0; }
  .tool-category {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--category-color) 16%, transparent);
    color: var(--category-color);
    font-size: 0.75rem;
    font-weight: 700;
  }
  [hidden] { display: none !important; }
</style>
