---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { authorUrl, canonicalAuthorName } from '../../../lib/authorUrl';
import { contributorPath, findContributorByName } from '../../../lib/contributorProfile';
import { url } from '../../../lib/url';
import GiscusComments from '../../../components/GiscusComments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const displayAuthor = canonicalAuthorName(entry.data.author);
const contributors = await getCollection('contributors');
const contributor = findContributorByName(displayAuthor, contributors);
const profile = contributor
  ? url(contributorPath(contributor.id))
  : authorUrl(displayAuthor, entry.data.linkedin);
const profileExternal = Boolean(profile?.startsWith('http'));
const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();
const contributorEntityUrl = contributor
  ? `${new URL(url(contributorPath(contributor.id)), Astro.site).toString()}#person`
  : undefined;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  datePublished: entry.data.date.toISOString(),
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  ...(entry.data.summary ? { description: entry.data.summary } : {}),
  ...(displayAuthor ? {
    author: contributorEntityUrl
      ? { '@type': 'Person', '@id': contributorEntityUrl, name: displayAuthor }
      : { '@type': 'Person', name: displayAuthor, ...(profile ? { url: profile } : {}) },
  } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Decision Management Community',
    url: 'https://dmcommunity.org/',
  },
};
---
<BaseLayout title={entry.data.title} description={entry.data.summary ?? entry.data.title}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <a href={url('/resources/articles/')}>&larr; All articles</a>
  <h1>{entry.data.title}</h1>
  <p class="muted">
    {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
    {displayAuthor ? (
      <>
        {' · '}
        {profile ? (
          <a href={profile} target={profileExternal ? '_blank' : undefined} rel={profileExternal ? 'noopener' : undefined}>{displayAuthor}</a>
        ) : displayAuthor}
      </>
    ) : ''}
  </p>

  {entry.data.challengeUrl && (
    <p><a href={url(entry.data.challengeUrl)}>&larr; View the original challenge</a></p>
  )}

  <article class="prose">
    <Content />
  </article>

  {entry.data.documentUrl && (
    <p>
      <a class="btn secondary" href={url(entry.data.documentUrl)} target="_blank" rel="noopener">
        View or download the migrated solution document &rarr;
      </a>
    </p>
  )}

  {(entry.data.linkedin || (entry.data.originalUrl && !entry.data.documentUrl)) && (
    <footer class="post-footer muted">
      {contributor && (
        <p>
          More from <a href={url(contributorPath(contributor.id))}>{displayAuthor}</a> on DMCommunity.
        </p>
      )}
      {entry.data.linkedin && (
        <p>
          Connect with me on <a href={entry.data.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </p>
      )}
      {entry.data.originalUrl && !entry.data.documentUrl && (
        <p>
          Originally published on{' '}
          <a href={entry.data.originalUrl} target="_blank" rel="noopener">{entry.data.originalUrl}</a>
        </p>
      )}
    </footer>
  )}

  <GiscusComments />
</BaseLayout>

<style>
  .post-footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .post-footer p { margin: 0.35rem 0; }
</style>
