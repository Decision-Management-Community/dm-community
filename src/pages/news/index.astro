---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, getCollection, render } from 'astro:content';
import { url } from '../../lib/url';

const entry = await getEntry('pages', 'news');
const { Content } = await render(entry!);

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const tags = [...tagCounts.keys()].sort((a, b) => a.localeCompare(b));

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const year = p.data.date.getUTCFullYear();
  const list = byYear.get(year) ?? [];
  list.push(p);
  byYear.set(year, list);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<BaseLayout title="News" description={entry?.data.description}>
  <h1>{entry?.data.title}</h1>
  {entry?.data.description && <p class="lede">{entry.data.description}</p>}

  {years.length > 1 && (
    <nav class="year-jump" aria-label="Jump to year">
      {years.map((year) => <a href={`#y${year}`}>{year}</a>)}
    </nav>
  )}

  <div class="archive-tools">
    <label>
      <span>Search the archive</span>
      <input id="news-search" type="search" placeholder="Search titles, authors, and topics" autocomplete="off" />
    </label>
    <label>
      <span>Topic</span>
      <select id="news-topic">
        <option value="">All topics</option>
        {tags.map((tag) => <option value={tag}>{tag} ({tagCounts.get(tag)})</option>)}
      </select>
    </label>
    <p id="news-count" class="muted" aria-live="polite">{posts.length} articles</p>
  </div>

  <div id="news-archive">
  {years.map((year) => (
    <section class="year-section" id={`y${year}`} data-news-year>
      <h2 class="year-heading">{year}</h2>
      <div class="card-grid">
        {byYear.get(year)!.map((p) => (
          <article
            class="card news-card"
            data-search={`${p.data.title} ${p.data.author ?? ''} ${p.data.tags.join(' ')}`.toLocaleLowerCase()}
            data-tags={JSON.stringify(p.data.tags)}
          >
            {p.data.tags[0] && <span class="badge">{p.data.tags[0]}</span>}
            <h3><a href={url(`/news/${p.id}/`)}>{p.data.title}</a></h3>
            <p class="muted small">
              {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              {p.data.author ? ` · ${p.data.author}` : ''}
            </p>
          </article>
        ))}
      </div>
    </section>
  ))}
  </div>

  <button id="news-more" class="show-more" type="button" hidden>Show more articles</button>

  <article class="prose">
    <Content />
  </article>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = [...document.querySelectorAll('[data-search]')];
    const sections = [...document.querySelectorAll('[data-news-year]')];
    const search = document.querySelector('#news-search');
    const topic = document.querySelector('#news-topic');
    const count = document.querySelector('#news-count');
    const more = document.querySelector('#news-more');
    const pageSize = 60;
    let limit = pageSize;

    const apply = () => {
      const query = search.value.trim().toLocaleLowerCase();
      const selectedTopic = topic.value;
      const matches = cards.filter((card) => {
        const topics = JSON.parse(card.dataset.tags || '[]');
        return (!query || card.dataset.search.includes(query)) &&
          (!selectedTopic || topics.includes(selectedTopic));
      });
      const matchSet = new Set(matches);
      let shown = 0;
      for (const card of cards) {
        const visible = matchSet.has(card) && shown < limit;
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      for (const section of sections) {
        section.hidden = !section.querySelector('.news-card:not([hidden])');
      }
      count.textContent = `Showing ${shown} of ${matches.length} matching articles (${cards.length} total)`;
      more.hidden = shown >= matches.length;
    };

    search.addEventListener('input', () => { limit = pageSize; apply(); });
    topic.addEventListener('change', () => { limit = pageSize; apply(); });
    more.addEventListener('click', () => { limit += pageSize; apply(); });
    apply();
  });
</script>

<style>
  .small { font-size: 0.8rem; }
  .year-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt);
    border-radius: 8px;
  }
  .year-jump a {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .year-jump a:hover { color: var(--color-text); }
  .year-section {
    margin-top: 2rem;
  }
  .year-heading {
    font-family: var(--font-serif);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .archive-tools {
    display: grid;
    grid-template-columns: minmax(16rem, 2fr) minmax(12rem, 1fr);
    gap: 0.9rem 1rem;
    align-items: end;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-alt);
  }
  .archive-tools label { display: grid; gap: 0.35rem; font-weight: 600; }
  .archive-tools input,
  .archive-tools select {
    width: 100%;
    min-height: 2.6rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .archive-tools p { grid-column: 1 / -1; margin: 0; }
  .show-more {
    display: block;
    margin: 2rem auto;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-alt);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  [hidden] { display: none !important; }
  @media (max-width: 640px) {
    .archive-tools { grid-template-columns: 1fr; }
  }
</style>
