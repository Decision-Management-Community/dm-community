---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---
<BaseLayout title="Page Not Found">
  <h1>Page not found</h1>
  <p>
    The page you're looking for doesn't exist here. If you followed a link from the old
    dmcommunity.org site, that content may not have been migrated yet — see our
    <a href="https://github.com/Decision-Management-Community/dm-community/blob/main/CONTRIBUTING.md">contribution guide</a>
    if you'd like to help bring it over.
  </p>
  <p><a href={url('/')}>Back to the homepage</a></p>
</BaseLayout>
